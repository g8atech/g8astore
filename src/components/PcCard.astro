---
import Icon from "./Icon.astro";
import { pcFrom, euro, pcFamilies, type PcModel } from "../data/site";
interface Props { m: PcModel }
const { m } = Astro.props;
const fam = pcFamilies.find((f) => f.key === m.family)!;
---
<a class="pc-card reveal" href={`/configuratore/${m.slug}/`} data-family={m.family}>
  <div class="im">
    {m.images[0] ? <img src={m.images[0]} alt={m.name} loading="lazy" width="600" height="450" /> : <span class="noimg"><Icon name={fam.icon} />Foto in arrivo</span>}
    <span class={m.available ? "badge-av" : "badge-av ord"}>{m.available ? "Disponibile in negozio" : "Su ordinazione"}</span>
    <span class="badge-fam">{fam.name}</span>
  </div>
  <div class="bd">
    <h3>{m.name}</h3>
    <p class="cpu">{m.cpu}</p>
    <ul class="keys">{m.keys.map((k) => <li><Icon name="check" /> {k}</li>)}</ul>
    <div class="ft">
      <div class="price-from"><small>Configurato da</small><b>{euro(pcFrom(m))}</b><em>IVA inclusa, con RAM e SSD</em></div>
      <span class="btn btn-red btn-sm">Configura</span>
    </div>
  </div>
</a>
