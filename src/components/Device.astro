---
// Dispositivo illustrato e animato: sullo schermo scorre una diagnosi.
interface Props { kind?: "laptop" | "desktop" | "mac"; title?: string; items?: string[] }
const { kind = "laptop", title = "Diagnosi g8astore", items = ["Disco e SSD", "Memoria RAM", "Temperature", "Batteria"] } = Astro.props;
const silver = kind === "mac";
const frame = silver ? "#c9ced6" : "#1b2433";
const frameEdge = silver ? "#eef1f5" : "#3a4558";
// area schermo
const S = kind === "desktop" ? { x: 40, y: 20, w: 360, h: 225 } : { x: 70, y: 30, w: 380, h: 238 };
const rows = items.slice(0, 4);
---
<div class="device" role="img" aria-label={`Illustrazione: ${kind === "desktop" ? "PC fisso" : kind === "mac" ? "MacBook" : "notebook"} durante la diagnosi`}>
  <svg viewBox="0 0 520 380" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id={`scr-${kind}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#16213a" />
        <stop offset="1" stop-color="#0b1222" />
      </linearGradient>
      <linearGradient id={`deck-${kind}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color={silver ? "#dfe3e9" : "#2a3446"} />
        <stop offset="1" stop-color={silver ? "#a9b0bb" : "#151c29"} />
      </linearGradient>
      <linearGradient id={`scanl-${kind}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ff5a4f" stop-opacity="0" />
        <stop offset=".5" stop-color="#ff5a4f" stop-opacity=".55" />
        <stop offset="1" stop-color="#ff5a4f" stop-opacity="0" />
      </linearGradient>
      <clipPath id={`clip-${kind}`}><rect x={S.x} y={S.y} width={S.w} height={S.h} rx="6" /></clipPath>
    </defs>

    {kind === "desktop" ? (
      <g>
        <rect x="24" y="6" width="392" height="257" rx="16" fill={frame} stroke={frameEdge} stroke-width="2" />
        <path d="M196 263h48l10 46h-68z" fill="#222c3c" />
        <rect x="150" y="306" width="140" height="10" rx="5" fill="#2a3446" />
        <rect x="430" y="70" width="78" height="246" rx="12" fill="#1b2433" stroke="#3a4558" stroke-width="2" />
        <rect x="444" y="90" width="50" height="6" rx="3" fill="#3a4558" />
        <rect x="444" y="104" width="50" height="6" rx="3" fill="#3a4558" />
        <circle cx="469" cy="146" r="22" fill="none" stroke="#e2231a" stroke-width="3" opacity=".9" />
        <circle cx="469" cy="146" r="9" fill="#e2231a" opacity=".5" />
        <circle cx="469" cy="292" r="5" fill="#4ade80" />
      </g>
    ) : (
      <g>
        <rect x="56" y="16" width="408" height="266" rx="16" fill={frame} stroke={frameEdge} stroke-width="2" />
        <path d="M16 290h488l-22 30H38z" fill={`url(#deck-${kind})`} />
        <rect x="16" y="284" width="488" height="8" rx="4" fill={silver ? "#eef1f5" : "#3a4558"} />
        <rect x="222" y="290" width="76" height="6" rx="3" fill={silver ? "#9aa2ae" : "#0f1520"} />
      </g>
    )}

    <rect x={S.x} y={S.y} width={S.w} height={S.h} rx="6" fill={`url(#scr-${kind})`} />
    <g clip-path={`url(#clip-${kind})`}>
      <rect x={S.x} y={S.y} width={S.w} height="26" fill="rgba(255,255,255,.04)" />
      <circle cx={S.x + 14} cy={S.y + 13} r="4" fill="#ff5f57" /><circle cx={S.x + 28} cy={S.y + 13} r="4" fill="#febc2e" /><circle cx={S.x + 42} cy={S.y + 13} r="4" fill="#28c840" />
      <rect x={S.x + 18} y={S.y + 40} width="38" height="38" rx="9" fill="#fff" />
      <image href="/g8a-mark.png" x={S.x + 22} y={S.y + 47} width="30" height="23" />
      <text x={S.x + 68} y={S.y + 56} fill="#eef2f8" font-family="Inter, sans-serif" font-size="15" font-weight="800">{title}</text>
      <text x={S.x + 68} y={S.y + 74} fill="#8d99ab" font-family="Inter, sans-serif" font-size="11">Controllo completo in corso</text>
      <rect x={S.x + 18} y={S.y + 92} width={S.w - 36} height="7" rx="3.5" fill="rgba(255,255,255,.08)" />
      <rect class="bar" x={S.x + 18} y={S.y + 92} width={S.w - 36} height="7" rx="3.5" fill="#e2231a" />
      {rows.map((r, i) => (
        <g class={`chk c${i + 1}`}>
          <rect x={S.x + 18} y={S.y + 112 + i * 27} width={S.w - 36} height="21" rx="6" fill="rgba(255,255,255,.04)" />
          <circle cx={S.x + 32} cy={S.y + 122.5 + i * 27} r="6.5" fill="#22b35e" />
          <path d={`M${S.x + 28.5} ${S.y + 122.5 + i * 27}l2.5 2.5 4.5-5`} stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          <text x={S.x + 46} y={S.y + 126.5 + i * 27} fill="#c2cad6" font-family="Inter, sans-serif" font-size="11.5" font-weight="600">{r}</text>
          <text x={S.x + S.w - 26} y={S.y + 126.5 + i * 27} text-anchor="end" fill="#4ade80" font-family="Inter, sans-serif" font-size="10.5" font-weight="700">OK</text>
        </g>
      ))}
      <rect class="scan" x={S.x} y={S.y + 30} width={S.w} height="40" fill={`url(#scanl-${kind})`} />
    </g>
    <rect x={S.x} y={S.y} width={S.w} height={S.h} rx="6" fill="none" stroke="rgba(255,90,79,.35)" stroke-width="1.5" />
  </svg>
</div>
