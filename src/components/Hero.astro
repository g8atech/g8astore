---
// Apertura delle pagine. variant "people": le foto vere dei fondatori; variant "photo": foto della riparazione a tutto schermo.
import Icon from "./Icon.astro";
import WaIcon from "./WaIcon.astro";
import GoogleG from "./GoogleG.astro";
import Photo from "./Photo.astro";
import { waLink, telLink, fmtRating, phoneDisplay, type Shop } from "../data/site";
interface Props {
  variant?: "people" | "photo";
  photo?: string;
  photoAlt?: string;
  crumbs?: { name: string; path: string }[];
  sub: string;
  chips?: { t: string; price?: boolean }[];
  shop: Shop;
  msg: string;
  rating?: number | null;
  reviews?: number | null;
  ratingLabel?: string;
  diagTitle?: string;
  diagItems?: string[];
  diagFoot?: [string, string];
  secondary?: { href: string; label: string; icon?: string };
}
const { variant = "photo", photo = "notebook-rosso", photoAlt = "", crumbs = [], sub, chips = [{ t: "Diagnosi gratuita" }, { t: "Prezzo prima di riparare" }, { t: "Garanzia fino a 12 mesi" }], shop, msg, rating, reviews, ratingLabel = "su Google", diagTitle = "Diagnosi G8A Store", diagItems = ["Disco e SSD", "Memoria RAM", "Temperature", "Batteria"], diagFoot = ["Diagnosi", "Gratuita"], secondary } = Astro.props;
---
<section class={variant === "people" ? "hero hero-people" : "hero"}>
  {variant === "photo" && <div class="hero-bg"><Photo name={photo} alt={photoAlt} sizes="100vw" eager /></div>}
  <div class="wrap hero-in">
    <div class="hero-text">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Percorso">
          <ol><li><a href="/">Home</a></li>{crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>)}</ol>
        </nav>
      )}
      <h1><slot /></h1>
      <p class="hero-sub">{sub}</p>
      <div class="chips">{chips.map((c) => <span class={c.price ? "chip price" : "chip"}><Icon name={c.price ? "euro" : "checkc"} /> {c.t}</span>)}</div>
      <div class="hero-ctas">
        <a class="btn btn-wa" href={waLink(shop, msg)} rel="nofollow"><WaIcon /> Scrivici su WhatsApp</a>
        <div class="row2">
          <a class="btn btn-glass btn-sm" href={telLink(shop)}><Icon name="phone" /> {phoneDisplay(shop)}</a>
          <a class="btn btn-glass btn-sm" href={secondary?.href ?? "#contatti"}><Icon name={secondary?.icon ?? "pin"} /> {secondary?.label ?? "Negozi"}</a>
        </div>
      </div>
      {rating && reviews ? (
        <div class="gcard"><span class="g"><GoogleG /></span><span class="stars" aria-hidden="true">★★★★★</span><b>{fmtRating(rating)}</b><span style="color:#c9c9d1">{reviews} recensioni {ratingLabel}</span></div>
      ) : null}
    </div>
    {variant === "people" ? (
      <div class="people">
        <span class="people-ring" aria-hidden="true"></span>
        <img class="p2" src="/img/founder-2.webp" srcset="/img/founder-2-s.webp 640w, /img/founder-2.webp 1168w" sizes="(max-width: 960px) 45vw, 22vw" alt="Fondatore di G8A" width="584" height="870" fetchpriority="high" />
        <img class="p1" src="/img/founder-laptop.webp" srcset="/img/founder-laptop-s.webp 640w, /img/founder-laptop.webp 1213w" sizes="(max-width: 960px) 50vw, 26vw" alt="Fondatore di G8A con un notebook G8A" width="606" height="824" fetchpriority="high" />
        <div class="people-badge"><img src="/g8a-mark.svg" alt="" width="34" height="22" /><span><b>Giuseppe e Antonio Arrigo</b><small>fondatori di G8A</small></span></div>
      </div>
    ) : (
      <div class="diag" aria-hidden="true">
        <div class="diag-h"><span class="lg"><img src="/g8a-mark.svg" alt="" width="30" height="22" /></span><span><b>{diagTitle}</b><small>Controllo in corso</small></span></div>
        <div class="diag-bar"><i></i></div>
        <ul>{diagItems.slice(0, 4).map((d) => <li><Icon name="checkc" /> {d}<em>OK</em></li>)}</ul>
        <div class="diag-foot"><span>{diagFoot[0]}</span><b>{diagFoot[1]}</b></div>
      </div>
    )}
  </div>
</section>
