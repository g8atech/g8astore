---
// Blocco "Comparsi su": link agli articoli con logo della testata (dati in data/press.ts).
import { PRESS } from "../data/press";
---
<section class="sec-tight press" aria-label="Comparsi su">
  <div class="wrap">
    <h2 class="press-t">Comparsi su</h2>
    <ul class="press-l">
      {PRESS.map((p) => (
        <li><a href={p.url} target="_blank" rel="noopener" title={`${p.testata}: ${p.titolo}`}><img src={p.logo} alt={p.testata} height={p.h} loading="lazy" decoding="async" /><span>{p.titolo}</span></a></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .press { text-align: center; }
  .press-t { font-size: .85rem; text-transform: uppercase; letter-spacing: .08em; opacity: .7; margin: 0 0 12px; }
  .press-l { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 18px 36px; justify-content: center; align-items: center; }
  .press-l a { display: flex; flex-direction: column; align-items: center; gap: 6px; color: inherit; text-decoration: none; max-width: 300px; }
  .press-l img { width: auto; }
  .press-l span { font-size: .8rem; opacity: .75; line-height: 1.3; }
</style>
