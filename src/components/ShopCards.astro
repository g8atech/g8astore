---
import Icon from "./Icon.astro";
import WaIcon from "./WaIcon.astro";
import { waLink, compactHours, fmtRating, type Shop } from "../data/site";
interface Props { shops: Shop[]; suffix?: string; msg?: (s: Shop) => string; title?: string; sub?: string }
const { shops, suffix, msg, title = "I nostri negozi", sub = "Passa senza appuntamento oppure scrivi su WhatsApp al negozio più vicino." } = Astro.props;
const hrefFor = (s: Shop) => (suffix ? `/${s.slug}/${suffix}/` : `/negozi/${s.slug}/`);
---
<section class="sec" id="negozi">
  <div class="wrap">
    <div class="sec-head reveal"><span class="kicker"><Icon name="store" /> {shops.length} negozi</span><h2>{title}</h2><p>{sub}</p></div>
    <div class="shops">
      {shops.map((s) => (
        <article class="shop reveal">
          <a class="ph" href={hrefFor(s)} aria-label={`g8astore ${s.city}`}>
            {s.photo && <img src={s.photo} alt={`Ingresso del negozio g8astore di ${s.city}`} width="640" height="360" loading="lazy" />}
            {s.rating && s.reviews ? <span class="badge"><span class="stars" aria-hidden="true">★</span> {fmtRating(s.rating)} <span class="muted">({s.reviews})</span></span> : null}
          </a>
          <div class="bd">
            <h3><a href={hrefFor(s)}>g8astore {s.city}</a></h3>
            <p class="addr">{s.address}{s.hint ? `, ${s.hint.toLowerCase()}` : ""}</p>
            <p class="hrs">{compactHours(s.hours) ?? "Orari sulla scheda Google Maps"}</p>
            <div class="row">
              <a class="btn btn-ghost btn-sm" href={hrefFor(s)}>Dettagli</a>
              <a class="btn btn-wa btn-sm" href={waLink(s, msg ? msg(s) : `Ciao g8astore ${s.city}, ho bisogno di:`)} rel="nofollow"><WaIcon /> WhatsApp</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
