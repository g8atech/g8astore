---
// Banner dei cookie. "Rifiuta" ha lo stesso peso di "Accetta" e chiudere con la X equivale a rifiutare
// (linee guida cookie del Garante privacy, 10 giugno 2021). Si riapre da "Preferenze cookie" nel footer.
---
<div class="ckb" role="dialog" aria-modal="false" aria-labelledby="ckb-t" aria-describedby="ckb-d" data-ckb>
  <button class="ckb-x" type="button" aria-label="Chiudi e rifiuta i cookie non necessari" data-ckb-act="rifiuta">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
  </button>
  <p class="ckb-t" id="ckb-t">Rispettiamo la tua privacy</p>
  <p class="ckb-d" id="ckb-d">
    Usiamo cookie tecnici per far funzionare il sito. Solo se sei d'accordo usiamo anche cookie statistici (Google Analytics, Microsoft Clarity) per capire come viene usato il sito e migliorarlo.
    Puoi cambiare idea quando vuoi da “Preferenze cookie” in fondo alla pagina. <a href="/cookie-policy/">Cookie policy</a> · <a href="/privacy-policy/">Privacy</a>
  </p>
  <div class="ckb-btns">
    <button class="btn btn-dark" type="button" data-ckb-act="rifiuta">Rifiuta</button>
    <button class="btn btn-dark" type="button" data-ckb-act="accetta">Accetta</button>
  </div>
</div>

<script>
  type C = { a: boolean };
  const gc = (window as unknown as { g8aConsent: { read(): C | null; apply(c: C): void; save(a: boolean): C } }).g8aConsent;
  const box = document.querySelector("[data-ckb]") as HTMLElement;
  const decide = (a: boolean) => {
    const before = gc.read();
    gc.apply(gc.save(a));
    document.documentElement.classList.remove("no-consent");
    // Se prima era concesso e ora no, si ricarica per fermare gli script già partiti.
    if (before && before.a && !a) location.reload();
  };
  box.addEventListener("click", (e) => {
    const k = (e.target as HTMLElement).closest("[data-ckb-act]")?.getAttribute("data-ckb-act");
    if (k === "rifiuta") decide(false);
    else if (k === "accetta") decide(true);
  });
  document.querySelectorAll("[data-cookie-prefs]").forEach((b) => b.addEventListener("click", () => document.documentElement.classList.add("no-consent")));
</script>

<style>
  .ckb { display: none; position: fixed; z-index: 80; left: 1rem; bottom: 1rem; width: min(28rem, calc(100% - 2rem)); padding: 1.2rem 1.2rem 1.1rem; border-radius: 18px; background: #fff; color: var(--text); border: 1px solid var(--line); border-top: 4px solid var(--red); box-shadow: 0 24px 60px rgba(13, 13, 15, .28); font-size: .92rem; }
  :global(.no-consent) .ckb { display: block; animation: ckb-in .35s ease-out; }
  @keyframes ckb-in { from { opacity: 0; transform: translateY(20px); } }
  .ckb-x { position: absolute; top: .7rem; right: .7rem; display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border: 0; border-radius: 50%; background: var(--paper); color: var(--text); cursor: pointer; }
  .ckb-x:hover { color: var(--red); }
  .ckb-t { padding-right: 2.5rem; font-weight: 800; font-size: 1.05rem; }
  .ckb-d { margin-top: .5rem; color: var(--text-2); line-height: 1.5; }
  .ckb-d a { color: var(--text); font-weight: 700; text-decoration: underline; }
  .ckb-btns { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; margin-top: 1rem; }
  .ckb-btns .btn { min-height: 46px; padding: 10px 16px; font-size: .95rem; }
  @media (max-width: 640px) { .ckb { left: .5rem; right: .5rem; bottom: .5rem; width: auto; } }
  /* sopra la barra Chiama/WhatsApp fissa su telefono */
  @media (max-width: 899px) { :global(.no-consent) .ckb { bottom: 5.4rem; } }
</style>
