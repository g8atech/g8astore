---
import WaIcon from "./WaIcon.astro";
import { waLink, fmtRating, type Shop } from "../data/site";
interface Props { shop: Shop; title: string; text: string; msg: string }
const { shop, title, text, msg } = Astro.props;
---
<section class="s" style="padding-top:0">
  <div class="wrap">
    <div class="final">
      <h2>{title}</h2>
      <p>{text}</p>
      <a class="btn btn-wa-light" href={waLink(shop, msg)} rel="nofollow"><WaIcon /> Scrivici su WhatsApp</a>
      {shop.rating && shop.reviews ? <div class="frev"><span class="stars">★★★★★</span> {fmtRating(shop.rating)} su Google · {shop.reviews} recensioni a {shop.city}</div> : null}
    </div>
  </div>
</section>
