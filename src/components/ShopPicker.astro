---
// Scelta del negozio per le pagine senza un negozio preciso (home, servizi, guide, shop PC, vendita).
// Ogni pulsante con data-scegli="tel" o "wa" apre questa finestra: ogni negozio ha il suo numero, il suo WhatsApp,
// la sua email e il suo indirizzo. Il negozio scelto l'ultima volta (stessa chiave delle guide) viene mostrato per primo.
import Icon from "./Icon.astro";
import WaIcon from "./WaIcon.astro";
import StoreStatus from "./StoreStatus.astro";
import { shops, waNumber, telLink, mapsLink, mailLink, phoneDisplay, compactHours } from "../data/site";
---
<dialog class="spick" id="scegli-negozio" aria-labelledby="spick-t">
  <div class="spick-h">
    <div>
      <b id="spick-t" data-spick-title>Scegli il negozio</b>
      <small>Ti risponde direttamente il negozio che scegli.</small>
    </div>
    <button type="button" class="spick-x" data-spick-close aria-label="Chiudi"><span aria-hidden="true">×</span></button>
  </div>
  <ul class="spick-l">
    {shops.map((s) => (
      <li data-slug={s.slug} data-city={s.city} data-wa={waNumber(s.whatsapp)}>
        <div class="spick-i">
          <b>G8A Store {s.city}</b>
          <span>{s.address}, {s.city}</span>
          <span>{compactHours(s.hours) ?? "Orari su Google Maps"}</span>
          {s.hours && <span class="st" data-hours={s.hours}></span>}
        </div>
        <div class="spick-a">
          <a class="btn btn-line btn-xs" data-k="tel" href={telLink(s)} aria-label={`Chiama G8A Store ${s.city}, ${phoneDisplay(s)}`}><Icon name="phone" /> {phoneDisplay(s)}</a>
          <a class="btn btn-wa btn-xs" data-k="wa" href={`https://wa.me/${waNumber(s.whatsapp)}`} rel="nofollow" aria-label={`WhatsApp G8A Store ${s.city}`}><WaIcon /> WhatsApp</a>
          {mailLink(s) && <a class="btn btn-line btn-xs" data-k="mail" href={mailLink(s)!} aria-label={`Email a G8A Store ${s.city}: ${s.email}`}><Icon name="mail" /> Email</a>}
          <a class="btn btn-line btn-xs" data-k="maps" href={mapsLink(s)} target="_blank" rel="noopener" aria-label={`Indicazioni per G8A Store ${s.city}`}><Icon name="pin" /> Indicazioni</a>
        </div>
      </li>
    ))}
  </ul>
</dialog>
<StoreStatus />

<script>
  const KEY = "g8a_negozio";
  const dlg = document.getElementById("scegli-negozio") as HTMLDialogElement | null;
  const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const save = (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* storage non disponibile */ } };

  if (dlg && typeof dlg.showModal === "function") {
    const list = dlg.querySelector(".spick-l") as HTMLUListElement;
    const title = dlg.querySelector("[data-spick-title]") as HTMLElement;
    const items = Array.from(list.querySelectorAll<HTMLLIElement>("li"));

    document.addEventListener("click", (e) => {
      const t = (e.target as Element | null)?.closest?.("[data-scegli]") as HTMLElement | null;
      if (!t) return;
      e.preventDefault();
      const kind = t.dataset.scegli === "tel" ? "tel" : "wa";
      const msg = t.dataset.msg || "Ciao G8A Store, ho bisogno di:";
      title.textContent = kind === "tel" ? "Quale negozio vuoi chiamare?" : "A quale negozio vuoi scrivere?";
      dlg.dataset.kind = kind;
      for (const li of items) {
        const city = li.dataset.city || "";
        const testo = msg.includes(`G8A Store ${city}`) ? msg : msg.replace("G8A Store", `G8A Store ${city}`);
        (li.querySelector('[data-k="wa"]') as HTMLAnchorElement).href = `https://wa.me/${li.dataset.wa}?text=${encodeURIComponent(testo)}`;
      }
      // Il negozio usato l'ultima volta va in cima.
      const last = read();
      const first = items.find((li) => li.dataset.slug === last);
      items.forEach((li) => li.classList.toggle("is-last", li === first));
      if (first) list.prepend(first);
      dlg.showModal();
    });

    list.addEventListener("click", (e) => {
      const a = (e.target as Element | null)?.closest?.("a");
      const li = a?.closest("li") as HTMLLIElement | null;
      if (a && li?.dataset.slug) save(li.dataset.slug);
    });
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg || (e.target as Element).closest("[data-spick-close]")) dlg.close();
    });
  }
</script>

<style>
  .spick { border: 0; padding: 0; border-radius: 20px; width: min(560px, calc(100vw - 24px)); max-height: calc(100dvh - 32px); background: var(--paper, #fff); color: var(--text, #0d0d0f); box-shadow: 0 30px 80px rgba(0,0,0,.35); }
  .spick::backdrop { background: rgba(13,13,15,.6); backdrop-filter: blur(3px); }
  .spick-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 20px 22px 12px; position: sticky; top: 0; background: inherit; z-index: 1; }
  .spick-h b { display: block; font-size: 1.15rem; }
  .spick-h small { color: var(--muted, #666); }
  .spick-x { border: 0; background: var(--line, #eee); width: 36px; height: 36px; border-radius: 50%; font-size: 1.4rem; line-height: 1; cursor: pointer; color: inherit; flex: none; }
  .spick-l { list-style: none; margin: 0; padding: 0 14px 16px; }
  .spick-l li { border: 1.5px solid var(--line, #eee); border-radius: 14px; padding: 12px 14px; margin-top: 10px; }
  .spick-l li.is-last { border-color: var(--red, #e30613); }
  .spick-l li.is-last .spick-i b::after { content: " · il tuo negozio"; color: var(--red, #e30613); font-weight: 600; font-size: .85em; }
  .spick-i { display: grid; gap: 2px; font-size: .92rem; }
  .spick-i span { color: var(--muted, #666); }
  .spick-a { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .spick[data-kind="tel"] [data-k="tel"], .spick[data-kind="wa"] [data-k="wa"] { order: -1; }
</style>
