---
interface Props { items: [string, string][]; title?: string }
const { items, title = "Domande frequenti" } = Astro.props;
---
{items.length > 0 && (
  <section class="band">
    <div class="wrap">
      <div class="sec-head"><h2>{title}</h2></div>
      <div class="faq">
        {items.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>
)}
