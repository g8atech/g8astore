---
// Impaginazione delle pagine legali (privacy e cookie policy).
interface Props { titolo: string; aggiornato: string }
const { titolo, aggiornato } = Astro.props;
---
<section class="sec legal-page">
  <div class="wrap">
    <h1>{titolo}</h1>
    <p class="upd">Ultimo aggiornamento: {aggiornato}</p>
    <div class="lg"><slot /></div>
  </div>
</section>
<style>
  .legal-page .wrap { max-width: 820px; }
  .legal-page h1 { font-size: clamp(2rem, 4vw, 2.8rem); }
  .upd { color: var(--muted); margin-top: 6px; }
  .lg { margin-top: 28px; line-height: 1.65; color: var(--text-2); }
  .lg :global(h2) { margin: 34px 0 10px; font-size: 1.35rem; color: var(--text); }
  .lg :global(h3) { margin: 20px 0 6px; font-size: 1.05rem; color: var(--text); }
  .lg :global(p), .lg :global(ul) { margin-top: 10px; }
  .lg :global(ul) { padding-left: 1.2rem; list-style: disc; }
  .lg :global(a) { color: var(--red); font-weight: 600; }
  .lg :global(.tbl) { overflow-x: auto; margin-top: 12px; }
  .lg :global(table) { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .lg :global(th), .lg :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .lg :global(th) { color: var(--text); background: var(--paper); }
  .lg :global(code) { font-size: .85em; }
  .lg :global(.btn) { margin-top: 12px; }
</style>
