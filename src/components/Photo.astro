---
// Foto dal set in /public/img con versione piccola per i telefoni.
interface Props { name: string; alt: string; sizes?: string; eager?: boolean; class?: string }
const { name, alt, sizes = "(max-width: 800px) 100vw, 50vw", eager = false, class: cls } = Astro.props;
---
<img class={cls} src={`/img/${name}.webp`} srcset={`/img/${name}-s.webp 800w, /img/${name}.webp 1600w`} sizes={sizes} alt={alt} loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : undefined} />
