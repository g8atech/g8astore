---
import WaIcon from "./WaIcon.astro";
import { waLink, fmtRating, type Shop } from "../data/site";
interface Props { shop: Shop; href?: string; msg?: string }
const { shop, href = `/negozi/${shop.slug}/`, msg } = Astro.props;
---
<article class="shopcard">
  {shop.photo ? <img class="ph" src={shop.photo} alt={`Negozio g8astore a ${shop.city}`} loading="lazy" width="640" height="360" /> : <div class="ph" />}
  <div class="bd">
    <h3><a href={href}>g8astore {shop.city}</a></h3>
    <div class="meta">{shop.address}, {shop.zip} {shop.city} ({shop.province}){shop.hint ? ` · ${shop.hint}` : ""}</div>
    {shop.rating && shop.reviews ? <div class="meta"><span class="stars">★★★★★</span> {fmtRating(shop.rating)} su Google · {shop.reviews} recensioni</div> : null}
    <div class="row">
      <a class="btn btn-ghost" href={href}>Dettagli sede</a>
      <a class="btn btn-wa" href={waLink(shop, msg ?? `Ciao g8astore ${shop.city}, ho bisogno di:`)} rel="nofollow"><WaIcon /> WhatsApp</a>
    </div>
  </div>
</article>
