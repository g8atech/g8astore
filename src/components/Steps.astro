---
import Icon from "./Icon.astro";
const steps: [string, string, string][] = [
  ["chat", "Scrivici o passa in negozio", "Su WhatsApp o al banco: raccontaci cosa succede o cosa ti serve."],
  ["search", "Diagnosi e preventivo", "Diagnosi gratuita e prezzo esatto prima di iniziare. Se non procedi, non paghi."],
  ["checkc", "Ritiri il computer pronto", "Molti interventi si chiudono in giornata. Lo ritiri testato e con garanzia."],
];
---
<section class="sec">
  <div class="wrap">
    <div class="sec-head reveal"><span class="kicker"><Icon name="bolt" /> Semplice</span><h2>Come funziona</h2></div>
    <ol class="steps">
      {steps.map(([ic, t, p]) => <li class="step reveal"><span class="ic"><Icon name={ic} /></span><h3>{t}</h3><p>{p}</p></li>)}
    </ol>
  </div>
</section>
