---
import { mapsLink, telLink, phoneDisplay, nearby, type Shop } from "../data/site";
interface Props { shop: Shop; title?: string }
const { shop, title = `Dove siamo a ${shop.city}` } = Astro.props;
const near = nearby[shop.slug] || [];
---
<section class="s" style="padding-top:0">
  <div class="wrap">
    <div class="local">
      <div>
        <h2 style="font-size:24px;margin-bottom:16px">{title}</h2>
        <div class="infoline">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <span><b>{shop.address}</b> — {shop.zip} {shop.city} ({shop.province}){shop.hint ? <><br /><small style="color:var(--mut)">{shop.hint}</small></> : null}</span>
        </div>
        <div class="infoline">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <span class="hours">{shop.hours ? shop.hours.replace(/: /g, " · ") : "Orari aggiornati sulla scheda Google Maps"}</span>
        </div>
        <div class="infoline">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
          <a href={telLink(shop)}><b>{phoneDisplay(shop)}</b></a>
        </div>
        <a class="btn btn-ink" style="margin-top:8px" href={mapsLink(shop)} target="_blank" rel="noopener">Apri in Google Maps</a>
        {near.length > 0 && <p class="note" style="margin-top:16px">Clienti anche da {near.slice(0, -1).join(", ")} e {near[near.length - 1]}.</p>}
      </div>
      <a class="photo" href={mapsLink(shop)} target="_blank" rel="noopener" aria-label={`Mappa: g8astore ${shop.city}`}>
        {shop.photo && <img src={shop.photo} alt={`Ingresso del negozio g8astore di ${shop.city}`} loading="lazy" width="640" height="420" />}
      </a>
    </div>
  </div>
</section>
