---
import WaIcon from "./WaIcon.astro";
import { mapsLink, telLink, phoneDisplay, nearby, waLink, ratingText, type Shop } from "../data/site";
interface Props { shop: Shop; title?: string; msg?: string }
const { shop, title = `Il negozio di ${shop.city}`, msg } = Astro.props;
const near = nearby[shop.slug] || [];
---
<section class="band--alu" id="sede">
  <div class="wrap local">
    <div>
      <h2>{title}</h2>
      <dl>
        <div><dt>Indirizzo</dt><dd>{shop.address}, {shop.zip} {shop.city} ({shop.province}){shop.hint ? `\n${shop.hint}` : ""}</dd></div>
        <div><dt>Orari</dt><dd>{shop.hours ? shop.hours.replace(/: /g, "  ") : "Aggiornati sulla scheda Google Maps"}</dd></div>
        <div><dt>Telefono</dt><dd><a href={telLink(shop)}>{phoneDisplay(shop)}</a></dd></div>
        {ratingText(shop) && <div><dt>Su Google</dt><dd><span class="stars" aria-hidden="true">★</span> {ratingText(shop)}</dd></div>}
      </dl>
      <div class="actions">
        <a class="btn btn-wa" href={waLink(shop, msg ?? `Ciao g8astore ${shop.city}, ho bisogno di:`)} rel="nofollow"><WaIcon /> Scrivi al negozio</a>
        <a class="btn btn-line" href={mapsLink(shop)} target="_blank" rel="noopener">Indicazioni stradali</a>
      </div>
      {near.length > 0 && <p class="small muted" style="margin-top:20px">Vengono da noi anche da {near.slice(0, -1).join(", ")} e {near[near.length - 1]}.</p>}
    </div>
    {shop.photo && (
      <figure>
        <img src={shop.photo} alt={`Come trovare il negozio g8astore di ${shop.city}`} width="640" height="480" loading="lazy" />
        <figcaption>L'ingresso del negozio, in {shop.address}.</figcaption>
      </figure>
    )}
  </div>
</section>
