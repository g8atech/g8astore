---
import WaIcon from "./WaIcon.astro";
import { waLink, type Shop } from "../data/site";
interface Props { shop: Shop; title: string; text: string; msg: string }
const { shop, title, text, msg } = Astro.props;
---
<section class="band--dark">
  <div class="wrap cta-line">
    <div>
      <h2>{title}</h2>
      <p class="muted" style="margin-top:10px;max-width:52ch">{text}</p>
    </div>
    <a class="btn btn-wa" href={waLink(shop, msg)} rel="nofollow"><WaIcon /> Scrivici su WhatsApp</a>
  </div>
</section>
