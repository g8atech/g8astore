---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import WaIcon from "../components/WaIcon.astro";
import { SITE, shops, services, saleCategories, waLink, telLink, avgRating, fmtRating, totalReviews, type Shop } from "../data/site";

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: { name: string; path: string }[]; // per i dati strutturati; il percorso visibile è nell'hero
  schema?: (object | null)[];
  shop?: Shop;
  waMessage?: string;
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, path, crumbs = [], schema = [], shop, waMessage, noindex, ogImage } = Astro.props;
const canonical = new URL(path, SITE).toString();
const ref = shop ?? shops.find((s) => s.slug === "gallarate") ?? shops[0];
const wa = waLink(ref, waMessage ?? (shop ? `Ciao G8A Store ${shop.city}, ho bisogno di:` : "Ciao G8A Store, ho bisogno di:"));
const breadcrumbSchema = crumbs.length
  ? { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ name: "Home", path: "/" }, ...crumbs].map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.path, SITE).toString() })) }
  : null;
const allSchema = [...schema, breadcrumbSchema].filter(Boolean);
const menu = [
  { name: "Notebook", path: "/riparazione-notebook/" },
  { name: "PC fisso", path: "/riparazione-pc/" },
  { name: "Mac", path: "/riparazione-mac/" },
  { name: "Vendita PC", path: "/vendita-pc/" },
  { name: "Partite IVA", path: "/partite-iva/" },
  { name: "Negozi", path: "/negozi/" },
];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="G8A Store" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage ?? "/img/og-g8astore.jpg", SITE).toString()} />
    <meta name="theme-color" content="#0d0d0f" />
    <link rel="icon" type="image/svg+xml" href="/g8a-mark.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-label="G8A Store, pagina iniziale">
          <img class="logo" src="/g8astore-logo.svg" alt="G8A Store" width="203" height="36" />
        </a>
        <nav class="menu" aria-label="Menu principale">
          {menu.map((m) => <a href={m.path} aria-current={path.includes(m.path) ? "page" : undefined}>{m.name}</a>)}
        </nav>
        <div class="top-cta">
          <a class="btn btn-line btn-sm" href={telLink(ref)}><Icon name="phone" /> Chiama</a>
          <a class="btn btn-wa btn-sm" href={wa} rel="nofollow"><WaIcon /> WhatsApp</a>
        </div>
      </div>
      <nav class="mnav" aria-label="Menu">{menu.map((m) => <a href={m.path}>{m.name}</a>)}</nav>
    </header>

    <main><slot /></main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="brand" href="/" style="margin-bottom:14px">
              <img class="logo" src="/g8astore-logo-white.svg" alt="G8A Store" width="203" height="36" />
            </a>
            <p style="max-width:34ch">Riparazione e vendita computer per privati e partite IVA in {shops.length} negozi tra provincia di Varese, Milano nord e Lecco.</p>
          </div>
          <div><h2>Riparazioni</h2><ul>{services.map((s) => <li><a href={`/${s.slug}/`}>{s.name}</a></li>)}</ul></div>
          <div><h2>Vendita</h2><ul>{saleCategories.map((c) => <li><a href={`/${c.slug}/`}>{c.name}</a></li>)}<li><a href="/partite-iva/">Per partite IVA</a></li></ul></div>
          <div><h2>Negozi</h2><ul>{shops.map((s) => <li><a href={`/${s.slug}/`}>G8A Store {s.city}</a></li>)}</ul></div>
        </div>
        <p class="legal">G8A Store è un marchio di G8A Technology S.r.l., P.IVA 03981970126. Centro assistenza indipendente, non affiliato Apple. Per le aziende: <a href="https://www.g8a.it/">g8a.it</a></p>
      </div>
    </footer>

    <nav class="mbar" aria-label="Contatti rapidi">
      <a class="btn btn-line" href={telLink(ref)}><Icon name="phone" /> Chiama</a>
      <a class="btn btn-wa" href={wa} rel="nofollow"><WaIcon /> WhatsApp</a>
    </nav>

    <script is:inline>
      (function () {
        var els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) { els.forEach(function (e) { e.classList.add("in"); }); return; }
        var io = new IntersectionObserver(function (entries) { entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } }); }, { rootMargin: "0px 0px -8% 0px" });
        els.forEach(function (e) { io.observe(e); });
        setTimeout(function () { els.forEach(function (e) { e.classList.add("in"); }); }, 2500);
      })();
    </script>
  </body>
</html>
