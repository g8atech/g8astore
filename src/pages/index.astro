---
import Base from "../layouts/Base.astro";
import Tag from "../components/Tag.astro";
import ShopList from "../components/ShopList.astro";
import Steps from "../components/Steps.astro";
import Faq from "../components/Faq.astro";
import B2b from "../components/B2b.astro";
import WaIcon from "../components/WaIcon.astro";
import { shops, services, saleCategories, pivaPoints, totalReviews, avgRating, fmtRating, waLink, SITE } from "../data/site";
import { storeSchema, faqSchema } from "../lib/schema";

const ref = shops.find((s) => s.slug === "gallarate") ?? shops[0];
const cities = shops.map((s) => s.city);
const citiesText = `${cities.slice(0, -1).join(", ")} e ${cities[cities.length - 1]}`;
const faq: [string, string][] = [
  ["Devo prendere appuntamento?", "No. Passa in qualsiasi negozio negli orari di apertura per una valutazione gratuita, oppure scrivici prima su WhatsApp."],
  ["Quanto costa la diagnosi?", "Niente. Ti diamo il prezzo esatto prima di riparare e, se decidi di non procedere, non paghi nulla."],
  ["Riparate anche i Mac?", "Sì, MacBook Air e MacBook Pro, con listino per modello. Siamo un centro indipendente, non affiliato Apple."],
  ["Lavorate con le partite IVA?", "Sì: computer in fattura, riparazioni con priorità, backup, rete e assistenza remota per professionisti e piccole attività."],
  ["La garanzia vale in tutti i negozi?", `Sì, la garanzia sull'intervento vale in tutti i ${shops.length} negozi g8astore.`],
];
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${SITE}/#org`,
    name: "g8astore",
    url: `${SITE}/`,
    logo: `${SITE}/g8a-logo.png`,
    parentOrganization: { "@type": "Organization", name: "G8A Technology S.r.l.", url: "https://www.g8a.it/" },
    subOrganization: shops.map((s) => ({ "@id": `${SITE}/negozi/${s.slug}/#store` })),
  },
  ...shops.map((s) => storeSchema(s)),
  faqSchema(faq)!,
];
const serviceIntro: Record<string, string> = {
  "riparazione-notebook": "Portatili Windows di ogni marca",
  "riparazione-pc": "Desktop, assemblati e da gaming",
  "riparazione-mac": "MacBook Air e Pro, prezzi per modello",
};
---
<Base
  title="g8astore: riparazione e vendita computer in 5 negozi tra Varese, Milano e Lecco"
  description={`Riparazione notebook, PC e Mac e vendita computer per privati e partite IVA. Negozi a ${citiesText}. Diagnosi gratuita e prezzo prima di riparare.`}
  path="/"
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Il tuo computer, sistemato da chi lo ripara da quindici anni</h1>
        <p class="lede">Notebook, PC fissi e Mac: li ripariamo, li potenziamo e li vendiamo, per privati e partite IVA. In {shops.length} negozi tra Varesotto, Milano nord e Lecco.</p>
        <div class="actions">
          <a class="btn btn-wa" href={waLink(ref, "Ciao g8astore, ho bisogno di:")} rel="nofollow"><WaIcon /> Scrivici su WhatsApp</a>
          <a class="btn btn-line" href="#negozi">Trova il negozio</a>
        </div>
        {avgRating && (
          <p class="proof">
            <span><span class="stars" aria-hidden="true">★★★★★</span> <b>{fmtRating(avgRating)}</b> su Google</span>
            <span><b>{totalReviews}</b> recensioni nei {shops.length} negozi</span>
          </p>
        )}
      </div>
      <Tag
        title="Come lavoriamo"
        sub="Vale in tutti i negozi"
        rows={[["Diagnosi", "gratuita"], ["Prezzo", "prima di riparare"], ["Se non ripari", "non paghi"], ["Garanzia", "fino a 12 mesi"]]}
        foot={["g8astore", `${shops.length} negozi`]}
      />
    </div>
  </section>

  <section class="band--alu">
    <div class="wrap">
      <div class="sec-head">
        <h2>Cosa ripariamo</h2>
        <p>Scegli il tipo di computer: trovi i problemi più comuni, i tempi e, per i Mac, il listino completo.</p>
      </div>
      <div class="offer-grid">
        {services.map((s) => (
          <a href={`/${s.slug}/`}>
            <h3>{s.name}</h3>
            <p class="small muted">{serviceIntro[s.slug]}</p>
            <p>{s.problems.slice(0, 5).map((p, i) => (i ? p.name.charAt(0).toLowerCase() + p.name.slice(1) : p.name)).join(", ")}.</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band" style="padding-top:64px">
    <div class="wrap cols-2">
      <div>
        <div class="sec-head"><h2>Comprare un computer</h2><p>Lo configuriamo noi e te lo diamo pronto, con file e programmi del vecchio computer già trasferiti.</p></div>
        <ul class="rows">
          {saleCategories.map((c) => (
            <li><a href={`/${c.slug}/`}><span class="r-name">{c.name}</span><span class="r-desc">{c.for}</span><span class="r-end go" aria-hidden="true"></span></a></li>
          ))}
        </ul>
      </div>
      <div>
        <div class="sec-head"><h2>Per partite IVA</h2><p>Professionisti, studi e piccole attività: quello che serve per lavorare senza fermi.</p></div>
        <ul class="rows">
          {pivaPoints.slice(0, 5).map((x) => (
            <li><a href="/partite-iva/"><span class="r-name">{x.t}</span><span class="r-desc">{x.p}</span><span class="r-end go" aria-hidden="true"></span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="band" id="negozi">
    <div class="wrap">
      <div class="sec-head"><h2>I negozi</h2><p>Passa senza appuntamento, oppure scrivi su WhatsApp al negozio più vicino.</p></div>
      <ShopList shops={shops} />
    </div>
  </section>

  <Steps title="Dalla prima telefonata al ritiro" />
  <Faq items={faq} title="Prima di passare" />
  <section class="band"><div class="wrap"><B2b /></div></section>
</Base>
