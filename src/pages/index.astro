---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import ShopCards from "../components/ShopCards.astro";
import Steps from "../components/Steps.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import B2b from "../components/B2b.astro";
import GoogleG from "../components/GoogleG.astro";
import { shops, services, saleCategories, totalReviews, avgRating, fmtRating, problemIcon, serviceIcon, SITE } from "../data/site";
import { storeSchema, faqSchema } from "../lib/schema";

const ref = shops.find((s) => s.slug === "gallarate") ?? shops[0];
const cities = shops.map((s) => s.city);
const citiesText = `${cities.slice(0, -1).join(", ")} e ${cities[cities.length - 1]}`;
const faq: [string, string][] = [
  ["Devo prendere appuntamento?", "No. Passa in qualsiasi negozio negli orari di apertura per una valutazione gratuita, oppure scrivici prima su WhatsApp."],
  ["Quanto costa la diagnosi?", "Niente. Ti diamo il prezzo esatto prima di riparare e, se decidi di non procedere, non paghi nulla."],
  ["Riparate anche i Mac?", "Sì, MacBook Air e MacBook Pro, con listino per modello. Siamo un centro indipendente, non affiliato Apple."],
  ["Lavorate con le partite IVA?", "Sì: computer in fattura, riparazioni con priorità, backup, rete e assistenza remota per professionisti e piccole attività."],
  ["La garanzia vale in tutti i negozi?", `Sì, la garanzia sull'intervento vale in tutti i ${shops.length} negozi g8astore.`],
];
const schema = [
  { "@context": "https://schema.org", "@type": "Organization", "@id": `${SITE}/#org`, name: "g8astore", url: `${SITE}/`, logo: `${SITE}/g8a-logo.png`,
    parentOrganization: { "@type": "Organization", name: "G8A Technology S.r.l.", url: "https://www.g8a.it/" },
    subOrganization: shops.map((s) => ({ "@id": `${SITE}/negozi/${s.slug}/#store` })) },
  ...shops.map((s) => storeSchema(s)),
  faqSchema(faq),
];
const topProblems = [
  ["riparazione-notebook", "schermo"], ["riparazione-notebook", "batteria"], ["riparazione-pc", "non-si-accende"], ["riparazione-notebook", "pc-lento"],
  ["riparazione-pc", "virus"], ["riparazione-pc", "recupero-dati"], ["riparazione-pc", "upgrade-ssd-ram"], ["riparazione-notebook", "tastiera"],
].map(([svc, slug]) => ({ svc, p: services.find((s) => s.slug === svc)!.problems.find((x) => x.slug === slug)! }));
const servicePoints: Record<string, string[]> = {
  "riparazione-notebook": ["Schermo, batteria e tastiera", "HP, Lenovo, Dell, Asus, Acer, MSI", "Molti interventi in giornata"],
  "riparazione-pc": ["Non si accende o si spegne", "Alimentatore e scheda video", "Upgrade e PC gaming"],
  "riparazione-mac": ["MacBook Air e MacBook Pro", "Listino prezzi per modello", "Batteria e schermo"],
};
---
<Base
  title="g8astore: riparazione e vendita PC, notebook e Mac in 5 negozi"
  description={`Riparazione notebook, PC e Mac e vendita computer per privati e partite IVA. Negozi a ${citiesText}. Diagnosi gratuita e prezzo prima di riparare.`}
  path="/"
  schema={schema}
>
  <Hero
    shop={ref}
    sub={`Notebook, PC fissi e Mac: li ripariamo, li potenziamo e li vendiamo. ${shops.length} negozi tra Varese, Milano e Lecco.`}
    msg="Ciao g8astore, ho bisogno di:"
    rating={avgRating}
    reviews={totalReviews}
    ratingLabel={`media dei ${shops.length} negozi`}
    storeHref="#negozi"
    storeLabel="Trova il negozio più vicino"
  >Riparazione e vendita <span class="grad">PC</span></Hero>

  <section class="sec" style="padding-top:24px">
    <div class="wrap">
      <div class="sec-head reveal"><h2>Cosa ti serve?</h2><p>Scegli e ti portiamo subito alla pagina giusta.</p></div>
      <div class="choose">
        <a class="choice reveal" href="/riparazione-notebook/">
          <span class="ic"><Icon name="wrench" /></span>
          <h3>Riparare il computer</h3>
          <p>Notebook, PC fisso o Mac che non va? Diagnosi gratuita e prezzo prima di riparare.</p>
          <span class="go">Vai alle riparazioni <Icon name="arrow" /></span>
        </a>
        <a class="choice reveal" href="/vendita-pc/">
          <span class="ic"><Icon name="cart" /></span>
          <h3>Comprare un computer</h3>
          <p>Notebook, PC su misura, gaming e ricondizionati. Te lo diamo pronto all'uso.</p>
          <span class="go">Vai alla vendita <Icon name="arrow" /></span>
        </a>
        <a class="choice reveal" href="/partite-iva/">
          <span class="ic"><Icon name="briefcase" /></span>
          <h3>Sono una partita IVA</h3>
          <p>Computer in fattura, riparazioni con priorità, backup e assistenza remota.</p>
          <span class="go">Vai ai servizi <Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal"><span class="kicker"><Icon name="wrench" /> Riparazioni</span><h2>Ripariamo ogni tipo di computer</h2></div>
      <div class="cards">
        {services.map((s) => (
          <article class="card reveal">
            <div class="card-head"><span class="ic"><Icon name={serviceIcon[s.slug]} /></span><h3>{s.name}</h3></div>
            <ul class="list">{servicePoints[s.slug].map((x) => <li><Icon name="check" /> {x}</li>)}</ul>
            <a class="btn btn-ghost btn-sm" href={`/${s.slug}/`}>Scopri {s.name.toLowerCase()}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal"><span class="kicker"><Icon name="alert" /> Problemi comuni</span><h2>Cosa succede al tuo computer?</h2></div>
      <div class="tiles">
        {topProblems.map(({ svc, p }) => (
          <a class="tile reveal" href={`/${svc}/`}><Icon name={problemIcon[p.slug]} /><b>{p.name}</b><span>{p.short}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal"><span class="kicker"><Icon name="cart" /> Vendita</span><h2>Il computer giusto, scelto con te</h2><p>Lo configuriamo noi e trasferiamo i dati dal vecchio computer.</p></div>
      <div class="cards">
        {saleCategories.slice(0, 3).map((c) => (
          <article class="card reveal">
            <div class="card-head"><span class="ic"><Icon name={({ "pc-su-misura": "cpu", notebook: "laptop", "pc-gaming": "gamepad" } as Record<string, string>)[c.slug]} /></span><h3>{c.name}</h3></div>
            <p>{c.lede}</p>
            <a class="btn btn-ghost btn-sm" href={`/${c.slug}/`}>Scopri {c.name.toLowerCase()}</a>
          </article>
        ))}
      </div>
      <p class="center" style="margin-top:20px"><a class="btn btn-soft btn-sm" href="/vendita-pc/">Vedi anche workstation e ricondizionati</a></p>
    </div>
  </section>

  {avgRating && (
    <section class="sec">
      <div class="wrap reviews">
        <div class="score reveal">
          <span class="g" style="width:42px;height:42px;border-radius:50%;background:#fff;display:grid;place-items:center"><GoogleG /></span>
          <span class="n">{fmtRating(avgRating)}</span>
          <span class="stars" aria-hidden="true">★★★★★</span>
          <p><b style="color:#fff">{totalReviews} recensioni su Google</b> nei nostri {shops.length} negozi.</p>
        </div>
        <div class="shoprates">
          {shops.filter((s) => s.rating && s.reviews).map((s) => (
            <a class="shoprate reveal" href={`/negozi/${s.slug}/`}>
              <Icon name="pin" class="muted" />
              <b>{s.city}</b>
              <span class="v"><span class="stars" aria-hidden="true">★</span> {fmtRating(s.rating)}</span>
              <span class="c">{s.reviews} recensioni</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Steps />
  <ShopCards shops={shops} />
  <Faq items={faq} title="Prima di passare" />
  <Cta shop={ref} title="Hai un problema con il computer?" text="Scrivici cosa succede: ti rispondiamo in pochi minuti e ti diciamo se si risolve in giornata." msg="Ciao g8astore, ho un problema con il computer:" />
  <B2b />
</Base>
