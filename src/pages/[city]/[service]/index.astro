---
// Servizio × città: /gallarate/riparazione-notebook/, /gallarate/vendita-pc/, /gallarate/partite-iva/
import Base from "../../../layouts/Base.astro";
import Hero from "../../../components/Hero.astro";
import Icon from "../../../components/Icon.astro";
import LocalBlock from "../../../components/LocalBlock.astro";
import Steps from "../../../components/Steps.astro";
import Faq from "../../../components/Faq.astro";
import Cta from "../../../components/Cta.astro";
import B2b from "../../../components/B2b.astro";
import WaIcon from "../../../components/WaIcon.astro";
import { shops, services, saleCategories, pivaPoints, macModels, waLink, euro, problemIcon, serviceDevice, saleIcon, pivaIcon, type Shop, type Service } from "../../../data/site";
import { storeSchema, serviceSchema, faqSchema } from "../../../lib/schema";

type Props = { shop: Shop } & ({ kind: "service"; service: Service } | { kind: "vendita" } | { kind: "piva" });
export function getStaticPaths() {
  return shops.flatMap((shop) => [
    ...services.map((service) => ({ params: { city: shop.slug, service: service.slug }, props: { shop, kind: "service", service } })),
    { params: { city: shop.slug, service: "vendita-pc" }, props: { shop, kind: "vendita" } },
    { params: { city: shop.slug, service: "partite-iva" }, props: { shop, kind: "piva" } },
  ]);
}
const p = Astro.props as Props;
const { shop } = p;
const base = `/${shop.slug}/${Astro.params.service}/`;
const isMac = p.kind === "service" && p.service.slug === "riparazione-mac";

let name: string, h1a: string, h1b: string, sub: string, msg: string, faq: [string, string][], device: "laptop" | "desktop" | "mac" = "laptop", items: string[] | undefined;
if (p.kind === "service") {
  const s = p.service;
  name = s.name;
  [h1a, h1b] = [`${s.name} a`, shop.city];
  sub = s.lede;
  msg = `Ciao g8astore ${shop.city}, ho un ${s.device} da riparare:`;
  device = serviceDevice[s.slug];
  items = isMac ? ["Batteria", "Schermo Retina", "Tastiera", "Scheda logica"] : s.slug === "riparazione-pc" ? ["Alimentatore", "Scheda video", "Disco e SSD", "Temperature"] : undefined;
  faq = [
    [`Quanto costa la ${s.name.toLowerCase()} a ${shop.city}?`, isMac ? "Trovi il listino per modello in questa pagina. Per gli altri guasti la diagnosi è gratuita e il prezzo te lo diamo prima di riparare." : "Dipende dal guasto e dal modello. La diagnosi è gratuita e ricevi il prezzo esatto prima dell'intervento; se non procedi, non paghi."],
    ["Quanto tempo ci vuole?", "Pulizia, SSD e reinstallazione si chiudono spesso in giornata. Per i ricambi da ordinare ti diamo i tempi con il preventivo."],
    ["Salvate i miei dati?", "Sì. Prima di interventi su disco o sistema copiamo i tuoi dati, e se il computer non si accende li recuperiamo quasi sempre."],
    ...s.problems.flatMap((pr) => pr.faq).slice(0, 2),
  ];
} else if (p.kind === "vendita") {
  name = "Vendita PC";
  [h1a, h1b] = ["Vendita PC a", shop.city];
  sub = `Notebook, PC su misura, gaming, workstation e ricondizionati. Configurati da noi e pronti all'uso, nel negozio di ${shop.address}.`;
  msg = `Ciao g8astore ${shop.city}, cerco un computer per:`;
  items = ["Configurazione", "Windows e driver", "Dati trasferiti", "Test finale"];
  faq = [
    ["Mi aiutate a scegliere?", "Sì. Dicci cosa ci devi fare e quanto vuoi spendere: ti proponiamo due o tre soluzioni senza venderti più del necessario."],
    ["Trasferite i dati dal vecchio computer?", "Sì, ti consegniamo il nuovo computer con file, posta e programmi principali già pronti."],
    ["Fate fattura alle partite IVA?", "Sì, vendiamo in fattura a professionisti e aziende."],
  ];
} else {
  name = "Partite IVA";
  [h1a, h1b] = ["Partite IVA a", shop.city];
  sub = `Per professionisti, studi e piccole attività di ${shop.city} e dintorni: computer in fattura, riparazioni con priorità, backup, rete e assistenza remota.`;
  msg = `Ciao g8astore ${shop.city}, ho una partita IVA e mi serve:`;
  items = ["Backup", "Rete e Wi-Fi", "Posta e PEC", "Aggiornamenti"];
  faq = [
    ["Fate assistenza anche da remoto?", "Sì. Per i problemi software interveniamo da remoto, senza farti venire in negozio."],
    ["Avete un contratto di assistenza per piccole attività?", "Per una o due postazioni lavoriamo a intervento. Per uffici con più postazioni da gestire a canone ti mettiamo in contatto con G8A, il nostro servizio per aziende."],
    ["Vendete in fattura?", "Sì: notebook, PC, monitor e accessori in fattura, configurati e pronti all'uso."],
  ];
}
const macRows = isMac ? macModels.map((m) => ({ m, battery: m.repairs.find((r) => r.kind === "batteria"), screen: m.repairs.find((r) => r.kind === "schermo") })) : [];
const offers = macRows.flatMap((r) => [r.battery, r.screen].filter(Boolean).map((x) => ({ name: x!.name, price: x!.price })));
const schema = [storeSchema(shop), serviceSchema(`${h1a} ${h1b}`, sub, shop, base, offers.slice(0, 40)), faqSchema(faq)];
---
<Base
  title={`${h1a} ${h1b} | g8astore`}
  description={`${h1a} ${h1b}: ${sub}`.slice(0, 158)}
  path={base}
  crumbs={[{ name: shop.city, path: `/negozi/${shop.slug}/` }, { name, path: base }]}
  schema={schema}
  shop={shop}
  waMessage={msg}
>
  <Hero shop={shop} sub={sub} msg={msg} rating={shop.rating} reviews={shop.reviews} device={device} deviceItems={items} storeHref="#sede" storeLabel="Orari e indicazioni">
    {h1a}{" "}<span class="grad">{h1b}</span>
  </Hero>

  {p.kind === "service" && (
    <section class="sec" style="padding-top:24px">
      <div class="wrap">
        <div class="sec-head reveal"><span class="kicker"><Icon name="wrench" /> Interventi</span><h2>Di cosa hai bisogno?</h2><p>Scegli il problema: ti spieghiamo cosa facciamo, i tempi e i prezzi.</p></div>
        <div class="tiles">
          {p.service.problems.map((pr) => <a class="tile reveal" href={`${base}${pr.slug}/`}><Icon name={problemIcon[pr.slug]} /><b>{pr.name}</b><span>{pr.short}</span></a>)}
        </div>
        {p.service.brands && (
          <div class="reveal" style="margin-top:32px;text-align:center">
            <h3 style="margin-bottom:14px">Ripariamo notebook di tutte le marche</h3>
            <div class="pills">{p.service.brands.map((b) => <a href={`${base}${b.slug}/`}>{b.name}</a>)}</div>
          </div>
        )}
      </div>
    </section>
  )}

  {macRows.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-head reveal"><span class="kicker"><Icon name="euro" /> Prezzi chiari</span><h2>Listino MacBook</h2><p>Batteria e schermo per modello, IVA inclusa. Il codice (per esempio A2337) è scritto sotto il MacBook.</p></div>
        <div class="scroll-x reveal">
          <table class="ptable">
            <thead><tr><th>Modello</th><th class="p">Batteria</th><th class="p">Schermo</th></tr></thead>
            <tbody>
              {macRows.map((r) => (
                <tr>
                  <td><a href={`${base}${r.m.slug}/`}>{r.m.name}</a></td>
                  <td class="p">{r.battery ? euro(r.battery.price) : "–"}</td>
                  <td class="p">{r.screen ? `da ${euro(r.screen.price)}` : "–"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="also" style="margin-top:14px">Non trovi il tuo modello? Scrivici il codice e lo verifichiamo noi.</p>
      </div>
    </section>
  )}

  {p.kind === "vendita" && (
    <section class="sec" style="padding-top:24px">
      <div class="wrap cards">
        {saleCategories.map((c) => (
          <article class="card reveal" id={c.slug}>
            <div class="card-head"><span class="ic"><Icon name={saleIcon[c.slug]} /></span><h3>{c.name}</h3></div>
            <p>{c.lede}</p>
            <ul class="list">{c.points.slice(0, 3).map((x) => <li><Icon name="check" /> {x}</li>)}</ul>
            <a class="btn btn-wa btn-sm" href={waLink(shop, `Ciao g8astore ${shop.city}, mi interessa: ${c.name}`)} rel="nofollow"><WaIcon /> Chiedi al negozio</a>
          </article>
        ))}
      </div>
    </section>
  )}

  {p.kind === "piva" && (
    <section class="sec" style="padding-top:24px">
      <div class="wrap cards">
        {pivaPoints.map((x, i) => <article class="card reveal"><div class="card-head"><span class="ic"><Icon name={pivaIcon[i]} /></span><h3>{x.t}</h3></div><p>{x.p}</p></article>)}
      </div>
    </section>
  )}

  <LocalBlock shop={shop} msg={msg} />
  <Steps />
  <Faq items={faq} />
  <Cta shop={shop} title={`${h1a} ${h1b}`} text={`Scrivici cosa ti serve: ti risponde direttamente il negozio di ${shop.city}.`} msg={msg} />
  <section class="sec-tight"><div class="wrap"><p class="also">{name} anche a {shops.filter((s) => s.slug !== shop.slug).map((s, i, a) => <><a href={`/${s.slug}/${Astro.params.service}/`}>{s.city}</a>{i < a.length - 1 ? ", " : "."}</>)}</p></div></section>
  {p.kind !== "service" && <B2b />}
</Base>
