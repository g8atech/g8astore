---
// Servizio nella sede: /gallarate/riparazione-notebook/, /gallarate/vendita-pc/, /gallarate/partite-iva/
import Base from "../../../layouts/Base.astro";
import Hero from "../../../components/Hero.astro";
import Promises from "../../../components/Promises.astro";
import Icon from "../../../components/Icon.astro";
import Photo from "../../../components/Photo.astro";
import HowItWorks from "../../../components/HowItWorks.astro";
import LocalBlock from "../../../components/LocalBlock.astro";
import Faq from "../../../components/Faq.astro";
import Cta from "../../../components/Cta.astro";
import B2b from "../../../components/B2b.astro";
import WaIcon from "../../../components/WaIcon.astro";
import { shops, services, saleCategories, pivaPoints, macModels, macPriceRange, waLink, euro, repairTitle, type Shop, type Service } from "../../../data/site";
import { storeSchema, serviceSchema, faqSchema } from "../../../lib/schema";

type Props = { shop: Shop } & ({ kind: "service"; service: Service } | { kind: "vendita" } | { kind: "piva" });
export function getStaticPaths() {
  return shops.flatMap((shop) => [
    ...services.map((service) => ({ params: { city: shop.slug, service: service.slug }, props: { shop, kind: "service", service } })),
    { params: { city: shop.slug, service: "vendita-pc" }, props: { shop, kind: "vendita" } },
    { params: { city: shop.slug, service: "partite-iva" }, props: { shop, kind: "piva" } },
  ]);
}
const p = Astro.props as Props;
const { shop } = p;
const base = `/${shop.slug}/${Astro.params.service}/`;
const isMac = p.kind === "service" && p.service.slug === "riparazione-mac";

let name = "", h1a = "", sub = "", msg = "", photo = "notebook-rosso", faq: [string, string][] = [], diagTitle = "", diagItems: string[] = [];
if (p.kind === "service") {
  const s = p.service;
  name = s.name; h1a = `${s.name} a`; sub = s.lede; photo = s.photo; diagTitle = s.name; diagItems = s.problems.slice(0, 4).map((x) => x.name);
  msg = `Ciao g8astore ${shop.city}, ho un ${s.device} da riparare:`;
  faq = [
    [`Quanto costa la ${s.name.toLowerCase()} a ${shop.city}?`, isMac ? "Trovi il listino per modello in questa pagina. Per gli altri guasti la diagnosi è gratuita e il prezzo te lo diamo prima di riparare." : "Dipende dal guasto e dal modello. La diagnosi è gratuita e ricevi il prezzo esatto prima dell'intervento; se non procedi, non paghi."],
    ["Quanto tempo ci vuole?", "Pulizia, SSD e reinstallazione si chiudono spesso in giornata. Per i ricambi da ordinare ti diamo i tempi con il preventivo."],
    ["Salvate i miei dati?", "Sì. Prima di interventi su disco o sistema copiamo i tuoi dati, e se il computer non si accende li recuperiamo quasi sempre."],
    ["Serve appuntamento?", `No, passa in negozio a ${shop.city} negli orari di apertura oppure scrivici prima su WhatsApp.`],
  ];
} else if (p.kind === "vendita") {
  name = "Vendita PC"; h1a = "Vendita PC a"; photo = "scrivania-notebook"; diagTitle = "Il tuo nuovo PC"; diagItems = ["Scelta componenti", "Windows e driver", "Dati trasferiti", "Test finale"];
  sub = `Notebook, PC su misura, gaming, workstation e ricondizionati, configurati da noi e pronti all'uso, nel negozio di ${shop.address}.`;
  msg = `Ciao g8astore ${shop.city}, cerco un computer per:`;
  faq = [
    ["Mi aiutate a scegliere?", "Sì. Dicci cosa ci devi fare e quanto vuoi spendere: ti proponiamo due o tre soluzioni senza venderti più del necessario."],
    ["Trasferite i dati dal vecchio computer?", "Sì, ti consegniamo il nuovo computer con file, posta e programmi principali già pronti."],
    ["Fate fattura alle partite IVA?", "Sì, vendiamo in fattura a professionisti e aziende."],
  ];
} else {
  name = "Partite IVA"; h1a = "Computer e assistenza per partite IVA a"; photo = "ufficio-clienti"; diagTitle = "Il tuo ufficio"; diagItems = ["Backup dei dati", "Rete e Wi-Fi", "Posta e PEC", "Aggiornamenti"];
  sub = `Per professionisti, studi e piccole attività di ${shop.city} e dintorni: computer in fattura, riparazioni con priorità, backup, rete e assistenza remota.`;
  msg = `Ciao g8astore ${shop.city}, ho una partita IVA e mi serve:`;
  faq = [
    ["Fate assistenza anche da remoto?", "Sì. Per i problemi software interveniamo da remoto, senza farti venire in negozio."],
    ["Avete un contratto di assistenza per piccole attività?", "Per una o due postazioni lavoriamo a intervento. Per uffici con più postazioni da gestire a canone ti mettiamo in contatto con G8A, il nostro servizio per aziende."],
    ["Vendete in fattura?", "Sì: notebook, PC, monitor e accessori in fattura, configurati e pronti all'uso."],
  ];
}
const macRows = isMac ? macModels.map((m) => ({ m, battery: m.repairs.find((r) => r.kind === "batteria"), screen: m.repairs.find((r) => r.kind === "schermo") })) : [];
const offers = macRows.flatMap((r) => [r.battery, r.screen].filter(Boolean).map((x) => ({ name: x!.name, price: x!.price })));
const crumbs = [{ name: shop.city, path: `/${shop.slug}/` }, { name, path: base }];
const schema = [storeSchema(shop), serviceSchema(`${h1a} ${shop.city}`, sub, shop, base, offers.slice(0, 40)), faqSchema(faq)];
---
<Base title={`${h1a} ${shop.city} | g8astore`} description={`${h1a} ${shop.city}: ${sub}`.slice(0, 160)} path={base} crumbs={crumbs} schema={schema} shop={shop} waMessage={msg} ogImage={`/img/${photo}.webp`}>
  <Hero photo={photo} photoAlt={name} crumbs={crumbs} sub={sub} shop={shop} msg={msg} rating={shop.rating} reviews={shop.reviews} diagTitle={diagTitle} diagItems={diagItems} secondary={{ href: "#contatti", label: "Orari e mappa" }}>
    {h1a}{" "}<span class="grad-text">{shop.city}</span>
  </Hero>
  <Promises />

  {p.kind === "service" && (
    <section class="sec">
      <div class="wrap">
        <div class="head reveal"><span class="tag">{p.service.name} a {shop.city}</span><h2>Scegli la riparazione</h2><p>Ogni riparazione ha la sua pagina con sintomi, tempi, prezzi e domande frequenti.</p></div>
        <div class="pcards">
          {p.service.problems.slice(0, 3).map((pr) => (
            <a class="pcard reveal" href={`${base}${pr.slug}/`}>
              <div class="ph"><Photo name={pr.photo} alt={repairTitle(pr, p.service)} sizes="(max-width: 700px) 100vw, 33vw" /><span class="ic"><Icon name={pr.icon} /></span>{isMac && pr.macKind && macPriceRange(pr.macKind) && <span class="price-badge">da {euro(macPriceRange(pr.macKind)!.min)}</span>}</div>
              <div class="bd"><h3>{repairTitle(pr, p.service)}</h3><p>{pr.short}</p><span class="more">Scopri <Icon name="arrow" /></span></div>
            </a>
          ))}
        </div>
        <div class="tiles" style="margin-top:18px">{p.service.problems.slice(3).map((pr) => <a class="tile reveal" href={`${base}${pr.slug}/`}><span class="ic"><Icon name={pr.icon} /></span><b>{pr.name}</b><span>{pr.short}</span></a>)}</div>
        {p.service.brands && (
          <div class="reveal" style="margin-top:34px;text-align:center"><h3 style="margin-bottom:14px">Ripariamo notebook di tutte le marche</h3><div class="pills c">{p.service.brands.map((b) => <a href={`${base}${b.slug}/`}>{b.name}</a>)}</div></div>
        )}
      </div>
    </section>
  )}

  {macRows.length > 0 && (
    <section class="sec sec-paper">
      <div class="wrap">
        <div class="head reveal"><span class="tag">Prezzi chiari</span><h2>Listino MacBook a {shop.city}</h2><p>Batteria e schermo per modello, IVA inclusa. Il codice (per esempio A2337) è scritto sotto il MacBook.</p></div>
        <div class="scroll-x reveal">
          <table class="ptable">
            <thead><tr><th>Modello</th><th class="p">Batteria</th><th class="p">Schermo</th></tr></thead>
            <tbody>{macRows.map((r) => <tr><td><a href={`${base}${r.m.slug}/`}>{r.m.name}</a></td><td class="p">{r.battery ? euro(r.battery.price) : "–"}</td><td class="p">{r.screen ? `da ${euro(r.screen.price)}` : "–"}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {p.kind === "vendita" && (
    <section class="sec">
      <div class="wrap">
        <div class="head reveal"><span class="tag">Vendita a {shop.city}</span><h2>Il computer giusto, scelto con te</h2></div>
        <div class="pcards">
          {saleCategories.map((c) => (
            <article class="pcard reveal" id={c.slug}>
              <div class="ph"><Photo name={c.photo} alt={c.name} sizes="(max-width: 700px) 100vw, 33vw" /><span class="ic"><Icon name={c.icon} /></span></div>
              <div class="bd">
                <h3>{c.name}</h3><p>{c.lede}</p>
                <ul class="list">{c.points.slice(0, 3).map((x) => <li><Icon name="check" /> {x}</li>)}</ul>
                <a class="btn btn-wa btn-sm" style="margin-top:8px" href={waLink(shop, `Ciao g8astore ${shop.city}, mi interessa: ${c.name}`)} rel="nofollow"><WaIcon /> Chiedi al negozio</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {p.kind === "piva" && (
    <section class="sec">
      <div class="wrap">
        <div class="head reveal"><span class="tag">Partite IVA a {shop.city}</span><h2>Quello che serve a chi lavora</h2></div>
        <div class="tiles">{pivaPoints.map((x) => <div class="tile reveal"><span class="ic"><Icon name={x.icon} /></span><b>{x.t}</b><span>{x.p}</span></div>)}</div>
      </div>
    </section>
  )}

  <HowItWorks />
  <LocalBlock shop={shop} msg={msg} />
  <Faq items={faq} paper />
  <Cta shop={shop} title={`${h1a} ${shop.city}`} text={`Scrivici cosa ti serve: ti risponde direttamente il negozio di ${shop.city}.`} msg={msg} photo={photo} />
  <section class="sec-tight"><div class="wrap"><p class="also">{name} anche a {shops.filter((s) => s.slug !== shop.slug).map((s, i, a) => <><a href={`/${s.slug}/${Astro.params.service}/`}>{s.city}</a>{i < a.length - 1 ? ", " : "."}</>)}</p></div></section>
  {p.kind !== "service" && <B2b />}
</Base>
