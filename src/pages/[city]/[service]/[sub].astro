---
// Nella sede: riparazione completa (/gallarate/riparazione-notebook/batteria/), marca (/gallarate/riparazione-notebook/hp/),
// modello Mac (/gallarate/riparazione-mac/macbook-air-m1-a2337/)
import Base from "../../../layouts/Base.astro";
import RepairPage from "../../../components/RepairPage.astro";
import Hero from "../../../components/Hero.astro";
import Promises from "../../../components/Promises.astro";
import Icon from "../../../components/Icon.astro";
import Photo from "../../../components/Photo.astro";
import HowItWorks from "../../../components/HowItWorks.astro";
import LocalBlock from "../../../components/LocalBlock.astro";
import Faq from "../../../components/Faq.astro";
import Cta from "../../../components/Cta.astro";
import WaIcon from "../../../components/WaIcon.astro";
import { shops, services, macModels, euro, waLink, repairTitle, type Shop, type Service, type Problem, type MacModel } from "../../../data/site";
import { storeSchema, serviceSchema, faqSchema } from "../../../lib/schema";

type Brand = NonNullable<Service["brands"]>[number];
type Props = { shop: Shop; service: Service } & ({ kind: "problem"; problem: Problem } | { kind: "brand"; brand: Brand } | { kind: "mac"; model: MacModel });
export function getStaticPaths() {
  return shops.flatMap((shop) =>
    services.flatMap((service) => [
      ...service.problems.map((problem) => ({ params: { city: shop.slug, service: service.slug, sub: problem.slug }, props: { shop, service, kind: "problem", problem } })),
      ...(service.brands ?? []).map((brand) => ({ params: { city: shop.slug, service: service.slug, sub: brand.slug }, props: { shop, service, kind: "brand", brand } })),
      ...(service.slug === "riparazione-mac" ? macModels.map((model) => ({ params: { city: shop.slug, service: service.slug, sub: model.slug }, props: { shop, service, kind: "mac", model } })) : []),
    ])
  );
}
const p = Astro.props as Props;
const { shop, service } = p;
const path = `/${shop.slug}/${service.slug}/${Astro.params.sub}/`;
const base = `/${shop.slug}/${service.slug}/`;

let name = "", sub = "", msg = "", photo = "notebook-windows", faq: [string, string][] = [], rows: { name: string; price: number; warrantyMonths?: number | null }[] = [];
if (p.kind === "brand") {
  const b = p.brand;
  name = `Riparazione notebook ${b.name}`;
  sub = `Ripariamo notebook ${b.name} di ogni serie (${b.lines}): schermo, batteria, tastiera, cerniere, lentezza e recupero dati, con diagnosi gratuita e prezzo prima di riparare.`;
  msg = `Ciao g8astore ${shop.city}, ho un notebook ${b.name} da riparare:`;
  faq = [
    [`Riparate tutti i modelli ${b.name}?`, `Sì, notebook ${b.name} per la casa e per il lavoro. Per alcuni ricambi specifici, come schermi particolari o scocche, servono pochi giorni per l'ordine.`],
    ["Usate ricambi originali?", "Usiamo ricambi originali o compatibili di qualità. Ti diciamo sempre quale montiamo e, quando ci sono entrambe le opzioni, il prezzo di ciascuna."],
    ["Quanto costa la diagnosi?", "Niente. La diagnosi è gratuita e, se non procedi, non paghi."],
  ];
} else if (p.kind === "mac") {
  const m = p.model;
  name = `Riparazione ${m.name}`;
  photo = "macbook";
  sub = `Prezzi di riparazione per ${m.name}, IVA inclusa, nel negozio di ${shop.city}. Per tutti gli altri guasti la diagnosi è gratuita.`;
  msg = `Ciao g8astore ${shop.city}, ho un ${m.name} da riparare:`;
  rows = m.repairs.map((r) => ({ name: r.name, price: r.price, warrantyMonths: r.warrantyMonths }));
  faq = [
    ["Come trovo il codice del mio MacBook?", "È stampato in piccolo sul fondo del MacBook e inizia con la lettera A, per esempio A2337."],
    ["Siete un centro Apple?", "No, siamo un centro indipendente, non affiliato Apple. Ti diciamo sempre che ricambio usiamo."],
    ["Il mio guasto non è in listino?", "Scrivici o passa in negozio: la diagnosi è gratuita e ti diamo il prezzo prima di riparare."],
  ];
}
const crumbs = p.kind === "problem" ? [] : [{ name: shop.city, path: `/${shop.slug}/` }, { name: service.name, path: base }, { name: p.kind === "brand" ? p.brand.name : p.model.name, path }];
const from = rows[0]?.price;
---
{p.kind === "problem" ? (
  <RepairPage problem={p.problem} service={service} shop={shop} />
) : (
  <Base title={`${name} a ${shop.city}${from ? ` da ${euro(from)}` : ""} | g8astore`} description={`${name} a ${shop.city}. ${from ? `Da ${euro(from)}. ` : "Diagnosi gratuita, prezzo prima di riparare. "}${shop.address}.`} path={path} crumbs={crumbs} schema={[storeSchema(shop), serviceSchema(`${name} a ${shop.city}`, sub, shop, path, rows), faqSchema(faq)]} shop={shop} waMessage={msg} ogImage={`/img/${photo}.webp`}>
    <Hero photo={photo} photoAlt={name} crumbs={crumbs} sub={sub} chips={[...(from ? [{ t: `da ${euro(from)}`, price: true }] : []), { t: "Diagnosi gratuita" }, { t: "Garanzia fino a 12 mesi" }]} shop={shop} msg={msg} rating={shop.rating} reviews={shop.reviews} diagTitle={p.kind === "brand" ? `Notebook ${p.brand.name}` : p.model.name} diagItems={p.kind === "brand" ? ["Schermo e cavo video", "Batteria", "Disco e SSD", "Temperature"] : ["Batteria", "Schermo Retina", "Tastiera", "Scheda logica"]} secondary={{ href: "#contatti", label: "Orari e mappa" }}>
      {name} a{" "}<span class="grad-text">{shop.city}</span>
    </Hero>
    <Promises />

    {p.kind === "brand" && (
      <section class="sec">
        <div class="wrap">
          <div class="head reveal"><span class="tag">Notebook {p.brand.name}</span><h2>Cosa ripariamo sui notebook {p.brand.name}</h2></div>
          <div class="pcards">
            {service.problems.slice(0, 3).map((pr) => (
              <a class="pcard reveal" href={`${base}${pr.slug}/`}>
                <div class="ph"><Photo name={pr.photo} alt={repairTitle(pr, service)} sizes="(max-width: 700px) 100vw, 33vw" /><span class="ic"><Icon name={pr.icon} /></span></div>
                <div class="bd"><h3>{pr.name} {p.brand.name}</h3><p>{pr.short}</p><span class="more">Scopri <Icon name="arrow" /></span></div>
              </a>
            ))}
          </div>
          <div class="tiles" style="margin-top:18px">{service.problems.slice(3).map((pr) => <a class="tile reveal" href={`${base}${pr.slug}/`}><span class="ic"><Icon name={pr.icon} /></span><b>{pr.name}</b><span>{pr.short}</span></a>)}</div>
        </div>
      </section>
    )}

    {p.kind === "mac" && (
      <section class="sec">
        <div class="wrap summary">
          <div class="reveal">
            <span class="tag">Listino {p.model.name}</span>
            <h2 style="margin-top:10px;margin-bottom:22px">Prezzi a {shop.city}</h2>
            <div class="scroll-x">
              <table class="ptable">
                <thead><tr><th>Intervento</th><th>Garanzia</th><th class="p">Prezzo</th></tr></thead>
                <tbody>{rows.map((r) => <tr><td>{r.name}</td><td>{r.warrantyMonths ? `${r.warrantyMonths} mesi` : "–"}</td><td class="p">{euro(r.price)}</td></tr>)}</tbody>
              </table>
            </div>
            <p class="muted" style="margin-top:12px;font-size:.9rem">IVA inclusa. Il prezzo finale te lo confermiamo prima di riparare.</p>
          </div>
          <aside class="box box-dark reveal">
            <h3 style="margin-bottom:8px">{p.model.name}</h3>
            <dl class="facts">
              <div><dt><Icon name="euro" /> Da</dt><dd>{from ? euro(from) : "preventivo"}</dd></div>
              <div><dt><Icon name="search" /> Diagnosi</dt><dd>gratuita</dd></div>
              <div><dt><Icon name="store" /> Negozio</dt><dd>{shop.city}</dd></div>
            </dl>
            <a class="btn btn-wa" style="width:100%;margin-top:18px" href={waLink(shop, msg)} rel="nofollow"><WaIcon /> Prenota la riparazione</a>
          </aside>
        </div>
      </section>
    )}

    <HowItWorks />
    <LocalBlock shop={shop} msg={msg} />
    <Faq items={faq} paper />
    <Cta shop={shop} title={`${name} a ${shop.city}`} text={`Scrivici modello e problema: ti risponde direttamente il negozio di ${shop.city}.`} msg={msg} photo={photo} />
  </Base>
)}
