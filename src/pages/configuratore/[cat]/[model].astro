---
// Pagina di configurazione di un modello G8A: scelta RAM e SSD, prezzo che si aggiorna, invio al negozio su WhatsApp.
import Base from "../../../layouts/Base.astro";
import ShopNav from "../../../components/ShopNav.astro";
import Icon from "../../../components/Icon.astro";
import WaIcon from "../../../components/WaIcon.astro";
import PcCard from "../../../components/PcCard.astro";
import Promises from "../../../components/Promises.astro";
import Faq from "../../../components/Faq.astro";
import { catSlug, productPath, pcModels, pcFamilies, ramFor, ssdOptions, pcFrom, euro, sizeLabel, shops, waNumber, SITE, type PcModel } from "../../../data/site";
import { faqSchema } from "../../../lib/schema";

export function getStaticPaths() {
  return pcModels.map((m) => ({ params: { cat: catSlug[m.family], model: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: PcModel };
const fam = pcFamilies.find((f) => f.key === m.family)!;
const rams = ramFor(m);
const ssds = ssdOptions;
const from = pcFrom(m);
const path = productPath(m);
const related = pcModels.filter((x) => x.family === m.family && x.slug !== m.slug).slice(0, 3);
const faq: [string, string][] = [
  [`Il ${m.name} arriva già pronto?`, "Sì: lo montiamo con la RAM e l'SSD che scegli, lo testiamo e lo ritiri pronto in negozio."],
  ["Posso aggiungere memoria in futuro?", `Sì, monta RAM ${m.ramType} SO-DIMM: quando vuoi potenziarlo te la installiamo noi.`],
  ["Il prezzo è definitivo?", "È il prezzo di listino IVA inclusa per la configurazione scelta. Il negozio te lo conferma insieme alla disponibilità prima di procedere."],
  ["Fate fattura alle partite IVA?", "Sì, vendiamo in fattura a professionisti e aziende."],
];
const product = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: m.name,
  brand: { "@type": "Brand", name: "G8A" },
  description: `${m.name} con ${m.cpu}. ${m.keys.join(". ")}.`,
  image: m.images.map((i) => new URL(i, SITE).toString()),
  offers: { "@type": "Offer", priceCurrency: "EUR", price: from, availability: m.available ? "https://schema.org/InStock" : "https://schema.org/PreOrder", url: new URL(path, SITE).toString(), seller: { "@type": "Organization", name: "G8A Store" } },
};
const crumbs = [{ name: "Shop PC", path: "/configuratore/" }, { name: fam.plural, path: `/configuratore/${catSlug[m.family]}/` }, { name: m.name, path }];
---
<Base title={`${m.name} configurabile da ${euro(from)} | G8A Store`} description={`${m.name}, ${m.cpu}: scegli RAM e SSD e vedi subito il prezzo. Da ${euro(from)} IVA inclusa, montato e testato in negozio.`} path={path} crumbs={crumbs} schema={[product, faqSchema(faq)]} ogImage={m.images[0]} waMessage={`Ciao G8A Store, mi interessa il ${m.name}:`}>
  <ShopNav current={m.family} />
  <div class="wrap cfg">
    <div class="gal">
      <div class="gal-main">
        {m.images[0] ? <img id="gal-main" src={m.images[0]} alt={m.name} width="1000" height="1000" fetchpriority="high" /> : <span class="muted" style="display:grid;justify-items:center;gap:8px"><Icon name={fam.icon} class="muted" />Foto in arrivo</span>}
      </div>
      {m.images.length > 1 && (
        <div class="gal-thumbs">
          {m.images.map((im, i) => <button type="button" data-src={im} aria-current={i === 0 ? "true" : "false"} aria-label={`Foto ${i + 1}`}><img src={im} alt="" width="76" height="76" loading="lazy" /></button>)}
        </div>
      )}
    </div>

    <div>
      <div class="cfg-head">
        <nav class="crumbs" aria-label="Percorso"><ol><li><a href="/">Home</a></li><li><a href="/configuratore/">Shop PC</a></li><li><a href={`/configuratore/${catSlug[m.family]}/`}>{fam.plural}</a></li><li><span aria-current="page">{m.name}</span></li></ol></nav>
        <h1>{m.name}</h1>
        <p class="cpu">{m.cpu}</p>
        <div class="keys">{m.keys.map((k) => <span>{k}</span>)}</div>
      </div>

      <form id="cfg" data-base={m.base} data-name={m.name} onsubmit="return false">
        <div class="step-box">
          <h2><b>1</b> Memoria RAM</h2>
          <div class="opts">
            {rams.map((r, i) => (
              <label class="opt">
                <input type="radio" name="ram" value={r.price} data-label={`${r.size} GB ${r.type}`} checked={i === 0} />
                <span class="dot" aria-hidden="true"></span>
                <span class="t"><b>{r.size} GB {r.type}</b><small>{r.size >= 16 ? "Consigliata per lavorare con tanti programmi" : "Per navigare, posta e documenti"}</small></span>
                <span class="p">{euro(r.price)}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="step-box">
          <h2><b>2</b> Disco SSD</h2>
          <div class="opts two">
            {ssds.map((s, i) => (
              <label class="opt">
                <input type="radio" name="ssd" value={s.price} data-label={`SSD ${sizeLabel(s.size)}`} checked={i === 0} />
                <span class="dot" aria-hidden="true"></span>
                <span class="t"><b>{sizeLabel(s.size)}</b><small>NVMe veloce</small></span>
                <span class="p">{euro(s.price)}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="step-box">
          <h2><b>3</b> Dove lo ritiri</h2>
          <select class="store-select" name="store" aria-label="Negozio di ritiro">
            {shops.map((s) => <option value={waNumber(s.whatsapp)} data-city={s.city} selected={s.slug === "gallarate"}>G8A Store {s.city} – {s.address}</option>)}
          </select>
        </div>

        <div class="summary-box" aria-live="polite">
          <span class={m.available ? "av" : "av ord"}>● {m.available ? "Base disponibile in negozio" : "Su ordinazione: ti diciamo i tempi"}</span>
          <div class="ln"><span>{m.name}</span><span>{euro(m.base)}</span></div>
          <div class="ln"><span id="s-ram">RAM</span><span id="p-ram"></span></div>
          <div class="ln"><span id="s-ssd">SSD</span><span id="p-ssd"></span></div>
          <div class="tot"><span>Totale</span><b id="tot">{euro(from)}</b></div>
          <p class="note">IVA inclusa. Prezzo di listino, confermato dal negozio insieme alla disponibilità.</p>
          <a id="wa" class="btn btn-wa" href="#" rel="nofollow"><WaIcon /> Richiedi questo PC su WhatsApp</a>
        </div>
      </form>
    </div>
  </div>

  <div class="mbar-price" aria-hidden="true"><span>{m.name}</span><b id="tot-m">{euro(from)}</b></div>
  <Promises />

  <section class="sec">
    <div class="wrap summary">
      <div class="reveal">
        <h2 style="margin-bottom:14px">Scheda tecnica</h2>
        <table class="spec-tab"><tbody>{m.specs.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table>
      </div>
      <aside class="box reveal">
        <h3 style="margin-bottom:10px">Cosa comprende</h3>
        <ul class="checks">
          <li><Icon name="checkc" /> Computer G8A montato con le componenti scelte</li>
          <li><Icon name="checkc" /> Test completo prima della consegna</li>
          <li><Icon name="checkc" /> Ritiro nel negozio che preferisci</li>
          <li><Icon name="checkc" /> Assistenza in negozio dopo l'acquisto</li>
        </ul>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="sec sec-paper">
      <div class="wrap">
        <div class="head reveal"><h2>Altri {fam.plural.toLowerCase()} G8A</h2></div>
        <div class="pc-grid">{related.map((x) => <PcCard m={x} />)}</div>
      </div>
    </section>
  )}
  <Faq items={faq} />

  <script is:inline>
    (function () {
      var f = document.getElementById("cfg"); if (!f) return;
      var base = parseFloat(f.dataset.base), name = f.dataset.name;
      var fmt = function (n) { var p = (Math.round(n * 100) / 100).toFixed(2).split("."); return p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ".") + (p[1] === "00" ? "" : "," + p[1]) + " €"; };
      function update() {
        var r = f.querySelector("input[name=ram]:checked"), s = f.querySelector("input[name=ssd]:checked"), st = f.store.options[f.store.selectedIndex];
        var tot = Math.round((base + parseFloat(r.value) + parseFloat(s.value)) * 100) / 100;
        document.getElementById("s-ram").textContent = "RAM " + r.dataset.label;
        document.getElementById("p-ram").textContent = fmt(parseFloat(r.value));
        document.getElementById("s-ssd").textContent = s.dataset.label;
        document.getElementById("p-ssd").textContent = fmt(parseFloat(s.value));
        document.getElementById("tot").textContent = fmt(tot);
        var tm = document.getElementById("tot-m"); if (tm) tm.textContent = fmt(tot);
        var msg = "Ciao G8A Store " + st.dataset.city + ", vorrei questo PC:\n" + name + "\n- RAM " + r.dataset.label + "\n- " + s.dataset.label + "\nTotale indicato sul sito: " + fmt(tot) + "\nMi confermate disponibilità e tempi?";
        document.getElementById("wa").href = "https://wa.me/" + st.value + "?text=" + encodeURIComponent(msg);
        document.querySelectorAll(".mbar .btn-wa").forEach(function (a) { a.href = document.getElementById("wa").href; });
      }
      f.addEventListener("change", update); update();
      var main = document.getElementById("gal-main");
      document.querySelectorAll(".gal-thumbs button").forEach(function (b) {
        b.addEventListener("click", function () {
          main.src = b.dataset.src;
          document.querySelectorAll(".gal-thumbs button").forEach(function (x) { x.setAttribute("aria-current", x === b ? "true" : "false"); });
        });
      });
    })();
  </script>
</Base>
