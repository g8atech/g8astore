---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import WaIcon from "../../components/WaIcon.astro";
import ShopNav from "../../components/ShopNav.astro";
import ShopGrid from "../../components/ShopGrid.astro";
import Faq from "../../components/Faq.astro";
import { pcModels, pcFamilies, pcFrom, euro, shops, waLink, catSlug } from "../../data/site";
import { faqSchema } from "../../lib/schema";

const ref = shops.find((s) => s.slug === "gallarate") ?? shops[0];
const minPrice = Math.min(...pcModels.map(pcFrom));
const cover: Record<string, string> = { notebook: "n16m-ultra", gaming: "vortex-i7-rtx5050", aio: "zenith-27", mini: "energy5" };
const faq: [string, string][] = [
  ["Come funziona l'acquisto?", "Scegli il PC e configura RAM e SSD: vedi subito il prezzo. Invii la richiesta al negozio su WhatsApp, ti confermiamo disponibilità e tempi e lo ritiri pronto in negozio."],
  ["Chi monta il computer?", "Lo montiamo e lo testiamo noi in negozio. Sono computer a marchio G8A."],
  ["Il prezzo è definitivo?", "È il prezzo di listino IVA inclusa della configurazione scelta. Il negozio te lo conferma insieme alla disponibilità prima di procedere."],
  ["Fate fattura alle partite IVA?", "Sì, vendiamo in fattura a professionisti e aziende."],
];
---
<Base title="Shop PC G8A: notebook, gaming, All in One e mini PC configurabili | G8A Store" description={`Lo shop dei PC G8A: notebook, notebook gaming, All in One e mini PC configurabili con RAM e SSD. Da ${euro(minPrice)} IVA inclusa, ritiro nei negozi G8A Store.`} path="/configuratore/" crumbs={[{ name: "Shop PC", path: "/configuratore/" }]} schema={[faqSchema(faq)]} ogImage={pcModels.find((m) => m.slug === "vortex-i7-rtx5050")?.images[0]}>
  <ShopNav current="all" />
  <div class="wrap">
    <div class="shop-banner">
      <img src="/img/pc-gaming.webp" alt="" />
      <nav class="crumbs" aria-label="Percorso"><ol><li><a href="/">Home</a></li><li><span aria-current="page">Shop PC</span></li></ol></nav>
      <h1>Shop PC G8A</h1>
      <p style="max-width:52ch">{pcModels.length} computer a marchio G8A da configurare con RAM e SSD. Prezzi IVA inclusa da {euro(minPrice)}, montati e testati nei nostri negozi.</p>
      <div class="acts" style="margin-top:6px"><a class="btn btn-red btn-sm" href="#prodotti">Vedi tutti i PC</a><a class="btn btn-glass btn-sm" href={waLink(ref, "Ciao G8A Store, vorrei un consiglio su quale PC scegliere:")} rel="nofollow"><WaIcon /> Chiedi un consiglio</a></div>
    </div>
    <div class="usp">
      <div><Icon name="wrench" /> Montato e testato da noi</div>
      <div><Icon name="store" /> Ritiro in {shops.length} negozi</div>
      <div><Icon name="receipt" /> Fattura per partite IVA</div>
      <div><Icon name="shield" /> Assistenza in negozio</div>
    </div>

    <section style="padding:22px 0 10px">
      <h2 style="font-size:1.6rem;margin-bottom:16px">Categorie</h2>
      <div class="cat-tiles">
        {pcFamilies.map((f) => {
          const ms = pcModels.filter((m) => m.family === f.key);
          const c = ms.find((m) => m.slug === cover[f.key]) ?? ms[0];
          return (
            <a class="cat-tile" href={`/configuratore/${catSlug[f.key]}/`}>
              <div class="im">{c?.images[0] && <img src={c.images[0]} alt={f.plural} loading="lazy" width="400" height="300" />}</div>
              <div class="bd"><b>{f.plural}</b><small>{ms.length} modelli · {f.desc}</small><span class="from">da {euro(Math.min(...ms.map(pcFrom)))}</span></div>
            </a>
          );
        })}
      </div>
    </section>

    <h2 style="font-size:1.6rem;margin-top:34px">Tutti i PC</h2>
    <ShopGrid models={pcModels} />
  </div>
  <Faq items={faq} paper />
</Base>
