---
// Guide pratiche scritte con Nina in Brain e firmate dalla direzione (Marketing → Guide).
// I dati arrivano in src/data/guideNina.ts dal workflow "Guide di Nina" (ogni ora, solo guide firmate).
// Senza guide non viene generata nessuna pagina: niente /guide/ vuota su Google.
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Faq from "../../components/Faq.astro";
import Contacts from "../../components/Contacts.astro";
import { GUIDE_NINA } from "../../data/guideNina";
import { SITE, shops } from "../../data/site";
import { faqSchema } from "../../lib/schema";

type Img = { url: string; alt: string; didascalia?: string };
type Sezione = { titolo: string; paragrafi?: string[]; punti?: string[]; immagine?: Img | null };
type Guida = {
  slug: string; titolo: string; h1: string; descrizione: string; intro: string; in_breve: string[];
  sezioni: Sezione[]; faq: { d: string; r: string }[]; link: { testo: string; url: string }[];
  firmato_da: string | null; pubblicata_il: string; aggiornata_il: string; copertina?: Img | null;
};

export function getStaticPaths() {
  const guide = (GUIDE_NINA as Guida[]).filter((g) => g.slug && g.firmato_da);
  if (!guide.length) return [];
  return [{ params: { slug: undefined }, props: { guida: null, guide } }, ...guide.map((g) => ({ params: { slug: g.slug }, props: { guida: g, guide } }))];
}

const { guida, guide } = Astro.props as { guida: Guida | null; guide: Guida[] };
const ref = shops.find((s) => s.slug === "gallarate") ?? shops[0];
const RUOLI: Record<string, string> = { "Giuseppe Arrigo": "co-fondatore di G8A Technology", "Antonio Arrigo": "co-fondatore di G8A Technology" };
const data = (iso: string) => new Intl.DateTimeFormat("it-IT", { day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Rome" }).format(new Date(`${iso}T12:00:00Z`));
const crumbs = guida ? [{ name: "Guide", path: "/guide/" }, { name: guida.h1, path: `/guide/${guida.slug}/` }] : [{ name: "Guide", path: "/guide/" }];

const schema = guida
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: guida.h1,
        ...(guida.copertina?.url ? { image: guida.copertina.url } : {}),
        description: guida.descrizione,
        inLanguage: "it-IT",
        datePublished: guida.pubblicata_il,
        dateModified: guida.aggiornata_il,
        mainEntityOfPage: new URL(`/guide/${guida.slug}/`, SITE).toString(),
        author: { "@type": "Organization", name: "G8A Store", url: SITE },
        publisher: { "@type": "Organization", name: "G8A Store", url: SITE, logo: { "@type": "ImageObject", url: new URL("/g8a-logo.png", SITE).toString() } },
      },
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        url: new URL(`/guide/${guida.slug}/`, SITE).toString(),
        name: guida.titolo,
        reviewedBy: guida.firmato_da ? { "@type": "Person", name: guida.firmato_da, ...(RUOLI[guida.firmato_da] ? { jobTitle: RUOLI[guida.firmato_da] } : {}) } : undefined,
        lastReviewed: guida.aggiornata_il,
      },
      guida.faq.length ? faqSchema(guida.faq.map((f) => [f.d, f.r] as [string, string])) : null,
    ]
  : [{ "@context": "https://schema.org", "@type": "CollectionPage", name: "Guide G8A Store", url: new URL("/guide/", SITE).toString(), hasPart: guide.map((g) => ({ "@type": "Article", headline: g.h1, url: new URL(`/guide/${g.slug}/`, SITE).toString() })) }];
const altre = guida ? guide.filter((g) => g.slug !== guida.slug).slice(0, 4) : [];
---
{guida ? (
  <Base title={`${guida.titolo} | G8A Store`} description={guida.descrizione} path={`/guide/${guida.slug}/`} crumbs={crumbs} schema={schema} waMessage={`Ciao G8A Store, ho letto la guida "${guida.h1}" e ho bisogno di:`} ogImage={guida.copertina?.url}>
    <Hero crumbs={crumbs} sub={guida.intro} shop={ref} msg={`Ciao G8A Store, ho letto la guida "${guida.h1}" e ho bisogno di:`} secondary={{ href: "#contatti", label: "Trova il negozio" }}>
      {guida.h1}
    </Hero>
    <section class="sec">
      <div class="wrap guide">
        <p class="byline">Guida di G8A Store{guida.firmato_da ? <> · verificata da <b>{guida.firmato_da}</b>{RUOLI[guida.firmato_da] ? `, ${RUOLI[guida.firmato_da]}` : ""}</> : null} · aggiornata il {data(guida.aggiornata_il)}</p>
        {guida.copertina?.url && <img class="cover" src={guida.copertina.url} alt={guida.copertina.alt} width="1200" height="800" />}
        {guida.in_breve.length > 0 && (
          <aside class="breve" aria-label="In breve">
            <b>In breve</b>
            <ul>{guida.in_breve.map((b) => <li>{b}</li>)}</ul>
          </aside>
        )}
        {guida.sezioni.map((s) => (
          <section>
            <h2>{s.titolo}</h2>
            {(s.paragrafi ?? []).map((p) => <p>{p}</p>)}
            {(s.punti ?? []).length > 0 && <ul class="punti">{s.punti!.map((p) => <li>{p}</li>)}</ul>}
            {s.immagine?.url && <figure><img src={s.immagine.url} alt={s.immagine.alt} width="1200" height="800" loading="lazy" />{s.immagine.didascalia && <figcaption>{s.immagine.didascalia}</figcaption>}</figure>}
          </section>
        ))}
        {guida.link.length > 0 && (
          <nav class="approf" aria-label="Per approfondire">
            <h2>Per approfondire</h2>
            <ul>{guida.link.map((l) => <li><a href={l.url}>{l.testo}</a></li>)}</ul>
          </nav>
        )}
      </div>
    </section>
    <Faq items={guida.faq.map((f) => [f.d, f.r] as [string, string])} paper />
    <Contacts msg={(s) => `Ciao G8A Store ${s.city}, ho letto la guida "${guida.h1}" e ho bisogno di:`} title="Serve una mano? Scrivi al negozio più vicino" paper={false} />
    {altre.length > 0 && (
      <section class="sec sec-paper">
        <div class="wrap">
          <div class="head c"><span class="tag">Guide</span><h2>Leggi anche</h2></div>
          <ul class="glist">{altre.map((g) => <li><a href={`/guide/${g.slug}/`}>{g.copertina?.url && <img src={g.copertina.url} alt="" width="1200" height="800" loading="lazy" />}<b>{g.h1}</b><span>{g.descrizione}</span></a></li>)}</ul>
        </div>
      </section>
    )}
  </Base>
) : (
  <Base title="Guide pratiche su PC, notebook e Mac | G8A Store" description="Guide pratiche dei tecnici G8A Store: cosa fare quando il PC, il notebook o il Mac ha un problema, cosa controllare da soli e quando serve l'assistenza." path="/guide/" crumbs={crumbs} schema={schema}>
    <Hero crumbs={crumbs} sub="Cosa fare quando il computer ha un problema, cosa puoi controllare da solo e quando conviene passare in negozio." shop={ref} msg="Ciao G8A Store, ho bisogno di:" secondary={{ href: "#guide", label: "Vedi le guide" }}>
      Guide <span class="grad-text">G8A Store</span>
    </Hero>
    <section class="sec" id="guide">
      <div class="wrap">
        <h2 class="sr-only">Tutte le guide</h2>
        <ul class="glist">{guide.map((g) => <li><a href={`/guide/${g.slug}/`}>{g.copertina?.url && <img src={g.copertina.url} alt="" width="1200" height="800" loading="lazy" />}<b>{g.h1}</b><span>{g.descrizione}</span></a></li>)}</ul>
      </div>
    </section>
    <Contacts msg={(s) => `Ciao G8A Store ${s.city}, ho bisogno di:`} />
  </Base>
)}

<style>
  .cover { width: 100%; height: auto; border-radius: 18px; margin: 0 0 24px; }
  figure { margin: 18px 0 0; }
  figure img { width: 100%; height: auto; border-radius: 16px; }
  figcaption { font-size: .88rem; color: var(--muted); margin-top: 6px; }
  .glist img { width: calc(100% + 36px); max-width: none; height: auto; aspect-ratio: 3/2; object-fit: cover; margin: -18px -18px 6px; border-radius: 14px 14px 0 0; }
  .guide { max-width: 760px; }
  .guide .byline { font-size: .9rem; color: var(--muted); margin-bottom: 22px; }
  .guide section + section, .guide .breve + section { margin-top: 30px; }
  .guide h2 { font-size: clamp(1.4rem, 2.6vw, 1.8rem); margin-bottom: 12px; }
  .guide p { color: var(--text-2); margin-bottom: 12px; }
  .guide .punti { list-style: disc; padding-left: 22px; color: var(--text-2); }
  .guide .punti li { margin-bottom: 6px; }
  .breve { border-left: 4px solid var(--red); background: var(--paper); border-radius: 12px; padding: 16px 18px; }
  .breve b { display: block; margin-bottom: 6px; }
  .breve ul { list-style: disc; padding-left: 20px; color: var(--text-2); }
  .approf { margin-top: 30px; }
  .approf ul { list-style: disc; padding-left: 22px; }
  .approf a { color: var(--red); text-decoration: underline; }
  .glist { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .glist a { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 18px; border: 1px solid var(--line); border-radius: var(--r); background: var(--white); box-shadow: var(--shadow); }
  .glist a:hover { border-color: var(--red); }
  .glist span { font-size: .92rem; color: var(--muted); }
</style>
