---
// Pagine generali (non legate a una città): servizi di riparazione, vendita, partite IVA.
import Base from "../layouts/Base.astro";
import Tag from "../components/Tag.astro";
import ShopList from "../components/ShopList.astro";
import Steps from "../components/Steps.astro";
import B2b from "../components/B2b.astro";
import Check from "../components/Check.astro";
import { shops, services, saleCategories, pivaPoints, macModels, macPriceRange, euro, type Service, type SaleCategory } from "../data/site";

type Props =
  | { kind: "service"; service: Service }
  | { kind: "sale"; cat: SaleCategory }
  | { kind: "vendita" }
  | { kind: "piva" };

export function getStaticPaths() {
  return [
    ...services.map((service) => ({ params: { hub: service.slug }, props: { kind: "service", service } })),
    ...saleCategories.map((cat) => ({ params: { hub: cat.slug }, props: { kind: "sale", cat } })),
    { params: { hub: "vendita-pc" }, props: { kind: "vendita" } },
    { params: { hub: "partite-iva" }, props: { kind: "piva" } },
  ];
}
const p = Astro.props as Props;
const cities = shops.map((s) => s.city).join(", ");

let title = "", description = "", h1 = "", lede = "", crumb = "", cityPath = "", shopMsg = "";
if (p.kind === "service") {
  const s = p.service;
  title = `${s.name} in ${shops.length} negozi tra Varese, Milano e Lecco | g8astore`;
  description = `${s.name} a ${cities}. ${s.lede}`;
  h1 = s.name;
  lede = s.lede;
  crumb = s.name;
  cityPath = s.slug;
  shopMsg = `ho un ${s.device} da riparare:`;
} else if (p.kind === "sale") {
  title = `${p.cat.name} a ${cities} | g8astore`;
  description = `${p.cat.lede} Negozi a ${cities}.`;
  h1 = p.cat.h1;
  lede = p.cat.lede;
  crumb = p.cat.name;
  cityPath = "vendita-pc";
  shopMsg = `mi interessa: ${p.cat.name.toLowerCase()}.`;
} else if (p.kind === "vendita") {
  title = "Vendita computer: notebook, PC su misura, gaming e ricondizionati | g8astore";
  description = `Notebook, PC su misura, PC gaming, workstation e ricondizionati garantiti nei negozi g8astore di ${cities}. Configurati e pronti all'uso.`;
  h1 = "Comprare un computer da noi";
  lede = "Notebook, PC su misura, gaming, workstation e ricondizionati: ti aiutiamo a scegliere e te lo consegniamo pronto, con i tuoi dati già trasferiti.";
  crumb = "Vendita";
  cityPath = "vendita-pc";
  shopMsg = "cerco un computer per:";
} else {
  title = "Computer e assistenza per partite IVA | g8astore";
  description = `Computer in fattura, riparazioni con priorità, backup, rete e assistenza remota per professionisti e piccole attività. Negozi a ${cities}.`;
  h1 = "Computer e assistenza per partite IVA";
  lede = "Per professionisti, studi e piccole attività: computer in fattura, riparazioni rapide e tutto quello che serve per lavorare senza fermi.";
  crumb = "Partite IVA";
  cityPath = "partite-iva";
  shopMsg = "ho una partita IVA e mi serve:";
}
const path = `/${Astro.params.hub}/`;
const crumbs = p.kind === "sale" ? [{ name: "Vendita", path: "/vendita-pc/" }, { name: crumb, path }] : [{ name: crumb, path }];
const battery = macPriceRange("batteria");
const screen = macPriceRange("schermo");

const tagRows: [string, string][] =
  p.kind === "service" && p.service.slug === "riparazione-mac" && battery && screen
    ? [["Batteria", `da ${euro(battery.min)}`], ["Schermo", `da ${euro(screen.min)}`], ["Modelli a listino", String(macModels.length)], ["Diagnosi", "gratuita"]]
    : p.kind === "service"
    ? [["Diagnosi", "gratuita"], ["Prezzo", "prima di riparare"], ["Molti interventi", "in giornata"], ["Garanzia", "fino a 12 mesi"]]
    : p.kind === "piva"
    ? [["Vendita", "in fattura"], ["Riparazioni", "con priorità"], ["Assistenza", "anche da remoto"], ["Più postazioni", "con G8A"]]
    : [["Consiglio", "gratuito"], ["Configurazione", "inclusa"], ["Dati trasferiti", "dal vecchio PC"], ["Assistenza", "in negozio"]];
---
<Base title={title} description={description} path={path} crumbs={crumbs}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>{h1}</h1>
        <p class="lede">{lede}</p>
        <div class="actions"><a class="btn btn-red" href="#negozi">Scegli il negozio</a></div>
      </div>
      <Tag title={crumb} sub={`In tutti i ${shops.length} negozi`} rows={tagRows} />
    </div>
  </section>

  {p.kind === "service" && (
    <section class="band--alu">
      <div class="wrap">
        <div class="sec-head"><h2>Gli interventi più richiesti</h2><p>Scegli il negozio qui sotto per vedere tempi, prezzi e contatti della sede.</p></div>
        <ul class="rows">
          {p.service.problems.map((pr) => <li><div class="row"><span class="r-name">{pr.name}</span><span class="r-desc">{pr.short}</span></div></li>)}
        </ul>
        {p.service.brands && (
          <div style="margin-top:32px">
            <h3 style="margin-bottom:12px">Tutte le marche</h3>
            <div class="pills">{p.service.brands.map((b) => <span>{b.name}</span>)}<span>e molte altre</span></div>
          </div>
        )}
      </div>
    </section>
  )}

  {p.kind === "sale" && (
    <section class="band--alu">
      <div class="wrap cols-2">
        <div>
          <h2 style="margin-bottom:16px">Cosa comprende</h2>
          <ul class="checks">{p.cat.points.map((x) => <li><Check /><span>{x}</span></li>)}</ul>
        </div>
        <div>
          <h2 style="margin-bottom:16px">Per chi è</h2>
          <p class="measure">{p.cat.for}. Passa in negozio o scrivici cosa ti serve e quanto vuoi spendere: ti proponiamo due o tre soluzioni, senza venderti più del necessario.</p>
        </div>
      </div>
    </section>
  )}

  {p.kind === "vendita" && (
    <section class="band--alu">
      <div class="wrap offer-grid">
        {saleCategories.map((c) => <a href={`/${c.slug}/`}><h3>{c.name}</h3><p>{c.lede}</p></a>)}
      </div>
    </section>
  )}

  {p.kind === "piva" && (
    <section class="band--alu">
      <div class="wrap offer-grid">
        {pivaPoints.map((x) => <div><h3>{x.t}</h3><p>{x.p}</p></div>)}
      </div>
    </section>
  )}

  <section class="band" id="negozi" style="padding-top:64px">
    <div class="wrap">
      <div class="sec-head"><h2>Scegli il negozio</h2></div>
      <ShopList shops={shops} suffix={cityPath} msg={(s) => `Ciao g8astore ${s.city}, ${shopMsg}`} />
    </div>
  </section>

  <Steps />
  <section class="band"><div class="wrap"><B2b /></div></section>
</Base>
