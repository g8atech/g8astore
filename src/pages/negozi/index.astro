---
import Base from "../../layouts/Base.astro";
import ShopCards from "../../components/ShopCards.astro";
import Icon from "../../components/Icon.astro";
import { shops } from "../../data/site";
import { storeSchema } from "../../lib/schema";
const cities = shops.map((s) => s.city).join(", ");
---
<Base
  title={`Negozi g8astore: ${cities}`}
  description={`I ${shops.length} negozi g8astore per riparazione e vendita computer: ${cities}. Indirizzi, orari, telefono e WhatsApp di ogni sede.`}
  path="/negozi/"
  crumbs={[{ name: "Negozi", path: "/negozi/" }]}
  schema={shops.map((s) => storeSchema(s))}
>
  <section class="hero" style="padding-bottom:0">
    <div class="wrap center" style="display:grid;gap:16px;justify-items:center">
      <span class="kicker"><Icon name="store" /> {shops.length} negozi</span>
      <h1 style="max-width:none">I negozi <span class="grad">g8astore</span></h1>
      <p class="hero-sub" style="margin:0">Passa senza appuntamento per una valutazione gratuita, oppure scrivi su WhatsApp al negozio più vicino.</p>
    </div>
  </section>
  <ShopCards shops={shops} title="Scegli il negozio" />
</Base>
