---
import Base from "../../layouts/Base.astro";
import Tag from "../../components/Tag.astro";
import LocalBlock from "../../components/LocalBlock.astro";
import Steps from "../../components/Steps.astro";
import Faq from "../../components/Faq.astro";
import CtaLine from "../../components/CtaLine.astro";
import B2b from "../../components/B2b.astro";
import WaIcon from "../../components/WaIcon.astro";
import { shops, services, saleCategories, pivaPoints, waLink, ratingText, compactHours, phoneDisplay, nearby, type Shop } from "../../data/site";
import { storeSchema, faqSchema } from "../../lib/schema";

export function getStaticPaths() {
  return shops.map((shop) => ({ params: { city: shop.slug }, props: { shop } }));
}
const { shop } = Astro.props as { shop: Shop };
const near = nearby[shop.slug] || [];
const faq: [string, string][] = [
  ["Devo prendere appuntamento?", `No. Passa in negozio a ${shop.city} negli orari di apertura per una valutazione gratuita. Se vuoi, scrivici prima su WhatsApp e ti diciamo quando passare.`],
  ["Quanto costa la diagnosi?", "Niente. Ricevi il preventivo prima di qualsiasi intervento e, se non procedi, non paghi."],
  ["Riparate anche i Mac?", "Sì, MacBook Air e MacBook Pro. Siamo un centro indipendente, non affiliato Apple."],
  ["Vendete computer con fattura alle partite IVA?", "Sì: notebook, PC e monitor in fattura, configurati e pronti all'uso."],
  ...(near.length > 1 ? [[`Arrivo da ${near[0]} o ${near[1]}: vale la pena?`, `Sì, molti nostri clienti arrivano da ${near.join(", ")}. Scrivici prima su WhatsApp: per molti interventi ti diciamo già se si risolve in giornata.`] as [string, string]] : []),
];
const msg = `Ciao g8astore ${shop.city}, ho bisogno di:`;
---
<Base
  title={`g8astore ${shop.city}: riparazione e vendita computer, ${shop.address}`}
  description={`g8astore ${shop.city}, ${shop.address}: riparazione notebook, PC e Mac e vendita computer per privati e partite IVA. Diagnosi gratuita e prezzo prima di riparare.`}
  path={`/negozi/${shop.slug}/`}
  crumbs={[{ name: "Negozi", path: "/negozi/" }, { name: shop.city, path: `/negozi/${shop.slug}/` }]}
  schema={[storeSchema(shop, true), faqSchema(faq)!]}
  shop={shop}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>g8astore {shop.city}</h1>
        <p class="lede">Riparazione e vendita di notebook, PC fissi e Mac per privati e partite IVA, in {shop.address}{shop.hint ? `, ${shop.hint.toLowerCase()}` : ""}.</p>
        <div class="actions">
          <a class="btn btn-wa" href={waLink(shop, msg)} rel="nofollow"><WaIcon /> Scrivi al negozio</a>
          <a class="btn btn-line" href="#sede">Orari e indicazioni</a>
        </div>
        {ratingText(shop) && <p class="proof"><span><span class="stars" aria-hidden="true">★★★★★</span> <b>{ratingText(shop)}</b></span></p>}
      </div>
      <Tag
        title={`Negozio di ${shop.city}`}
        sub={`${shop.address}, ${shop.zip} ${shop.city}`}
        rows={[["Orari", compactHours(shop.hours)?.split("; ")[0] ?? "vedi Google Maps"], ["Telefono", phoneDisplay(shop)], ["Diagnosi", "gratuita"], ["Prezzo", "prima di riparare"]]}
        foot={["g8astore", shop.province]}
      />
    </div>
  </section>

  <section class="band--alu">
    <div class="wrap">
      <div class="sec-head"><h2>Riparazioni a {shop.city}</h2></div>
      <div class="offer-grid">
        {services.map((s) => (
          <div>
            <h3><a class="link" style="text-decoration:none" href={`/${shop.slug}/${s.slug}/`}>{s.name}</a></h3>
            <ul class="small" style="list-style:none;display:grid;gap:4px">
              {s.problems.slice(0, 5).map((p) => <li><a href={`/${shop.slug}/${s.slug}/${p.slug}/`}>{p.name}</a></li>)}
            </ul>
            <a class="link small" href={`/${shop.slug}/${s.slug}/`}>Tutti gli interventi</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band" style="padding-top:64px">
    <div class="wrap cols-2">
      <div>
        <div class="sec-head"><h2>Computer in vendita</h2></div>
        <ul class="rows">
          {saleCategories.map((c) => <li><a href={`/${shop.slug}/vendita-pc/#${c.slug}`}><span class="r-name">{c.name}</span><span class="r-desc">{c.for}</span><span class="r-end go" aria-hidden="true"></span></a></li>)}
        </ul>
      </div>
      <div>
        <div class="sec-head"><h2>Per partite IVA</h2></div>
        <ul class="rows">
          {pivaPoints.slice(0, 5).map((x) => <li><a href={`/${shop.slug}/partite-iva/`}><span class="r-name">{x.t}</span><span class="r-desc">{x.p}</span><span class="r-end go" aria-hidden="true"></span></a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <LocalBlock shop={shop} />
  <Steps />
  <Faq items={faq} title="Prima di passare" />
  <CtaLine shop={shop} title="Riparazione o computer nuovo?" text={`Scrivici cosa ti serve: ti rispondiamo dal negozio di ${shop.city} e ti diciamo quando passare.`} msg={msg} />
  <section class="band">
    <div class="wrap" style="display:grid;gap:16px">
      <p class="also">Gli altri negozi: {shops.filter((s) => s.slug !== shop.slug).map((s, i, a) => <><a href={`/negozi/${s.slug}/`}>{s.city}</a>{i < a.length - 1 ? ", " : "."}</>)}</p>
      <B2b />
    </div>
  </section>
</Base>
