---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import LocalBlock from "../../components/LocalBlock.astro";
import Steps from "../../components/Steps.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import B2b from "../../components/B2b.astro";
import { shops, services, saleCategories, pivaPoints, nearby, serviceIcon, saleIcon, pivaIcon, problemIcon, type Shop } from "../../data/site";
import { storeSchema, faqSchema } from "../../lib/schema";

export function getStaticPaths() {
  return shops.map((shop) => ({ params: { city: shop.slug }, props: { shop } }));
}
const { shop } = Astro.props as { shop: Shop };
const near = nearby[shop.slug] || [];
const faq: [string, string][] = [
  ["Devo prendere appuntamento?", `No. Passa in negozio a ${shop.city} negli orari di apertura per una valutazione gratuita. Se vuoi, scrivici prima su WhatsApp e ti diciamo quando passare.`],
  ["Quanto costa la diagnosi?", "Niente. Ricevi il preventivo prima di qualsiasi intervento e, se non procedi, non paghi."],
  ["Riparate anche i Mac?", "Sì, MacBook Air e MacBook Pro. Siamo un centro indipendente, non affiliato Apple."],
  ["Vendete computer con fattura alle partite IVA?", "Sì: notebook, PC e monitor in fattura, configurati e pronti all'uso."],
  ...(near.length > 1 ? [[`Arrivo da ${near[0]} o ${near[1]}: vale la pena?`, `Sì, molti nostri clienti arrivano da ${near.join(", ")}. Scrivici prima su WhatsApp: per molti interventi ti diciamo già se si risolve in giornata.`] as [string, string]] : []),
];
const msg = `Ciao g8astore ${shop.city}, ho bisogno di:`;
---
<Base
  title={`Riparazione e vendita PC a ${shop.city} | g8astore ${shop.city}`}
  description={`g8astore ${shop.city}, ${shop.address}: riparazione notebook, PC e Mac e vendita computer per privati e partite IVA. Diagnosi gratuita e prezzo prima di riparare.`}
  path={`/negozi/${shop.slug}/`}
  crumbs={[{ name: "Negozi", path: "/negozi/" }, { name: shop.city, path: `/negozi/${shop.slug}/` }]}
  schema={[storeSchema(shop, true), faqSchema(faq)]}
  shop={shop}
>
  <Hero shop={shop} sub={`Notebook, PC fissi e Mac per privati e partite IVA. Ci trovi in ${shop.address}${shop.hint ? `, ${shop.hint.toLowerCase()}` : ""}.`} msg={msg} rating={shop.rating} reviews={shop.reviews} storeHref="#sede" storeLabel="Orari e indicazioni">
    Riparazione e vendita <span class="grad">PC</span> a {shop.city}
  </Hero>

  <section class="sec" style="padding-top:24px">
    <div class="wrap">
      <div class="sec-head reveal"><span class="kicker"><Icon name="wrench" /> Riparazioni a {shop.city}</span><h2>Cosa ripariamo qui</h2></div>
      <div class="cards">
        {services.map((s) => (
          <article class="card reveal">
            <div class="card-head"><span class="ic"><Icon name={serviceIcon[s.slug]} /></span><h3>{s.name}</h3></div>
            <ul class="list">{s.problems.slice(0, 4).map((p) => <li><Icon name="check" /> <a href={`/${shop.slug}/${s.slug}/${p.slug}/`}>{p.name}</a></li>)}</ul>
            <a class="btn btn-ghost btn-sm" href={`/${shop.slug}/${s.slug}/`}>Tutti gli interventi</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal"><span class="kicker"><Icon name="alert" /> Problemi comuni</span><h2>Cosa succede al tuo computer?</h2></div>
      <div class="tiles">
        {services[0].problems.slice(0, 8).map((p) => <a class="tile reveal" href={`/${shop.slug}/riparazione-notebook/${p.slug}/`}><Icon name={problemIcon[p.slug]} /><b>{p.name}</b><span>{p.short}</span></a>)}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal"><span class="kicker"><Icon name="cart" /> Vendita e partite IVA</span><h2>Comprare un computer a {shop.city}</h2></div>
      <div class="cards">
        {saleCategories.slice(0, 2).map((c) => (
          <article class="card reveal">
            <div class="card-head"><span class="ic"><Icon name={saleIcon[c.slug]} /></span><h3>{c.name}</h3></div>
            <p>{c.lede}</p>
            <a class="btn btn-ghost btn-sm" href={`/${shop.slug}/vendita-pc/#${c.slug}`}>Scopri</a>
          </article>
        ))}
        <article class="card reveal">
          <div class="card-head"><span class="ic"><Icon name="briefcase" /></span><h3>Per partite IVA</h3></div>
          <ul class="list">{pivaPoints.slice(0, 4).map((x, i) => <li><Icon name="check" /> {x.t}</li>)}</ul>
          <a class="btn btn-ghost btn-sm" href={`/${shop.slug}/partite-iva/`}>Servizi per partite IVA</a>
        </article>
      </div>
    </div>
  </section>

  <LocalBlock shop={shop} msg={msg} />
  <Steps />
  <Faq items={faq} title="Prima di passare" />
  <Cta shop={shop} title={`Ti aspettiamo a ${shop.city}`} text="Scrivici cosa ti serve: ti risponde direttamente il negozio e ti dice quando passare." msg={msg} />
  <section class="sec-tight"><div class="wrap"><p class="also">Gli altri negozi: {shops.filter((s) => s.slug !== shop.slug).map((s, i, a) => <><a href={`/negozi/${s.slug}/`}>{s.city}</a>{i < a.length - 1 ? ", " : "."}</>)}</p></div></section>
  <B2b />
</Base>
